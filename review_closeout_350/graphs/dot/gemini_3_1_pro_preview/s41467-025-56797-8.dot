  "Node_3" -> "Node_5" [label="abduction-knowledge"];
  "Node_5" -> "R3" [label="abduction-phenomenon"];
  "Node_6" -> "R3" [label="abduction-knowledge"];
  "Node_9" -> "R4" [label="abduction-phenomenon"];
  "Node_8" -> "R4" [label="abduction-knowledge"];
  "R4" -> "R5" [label="abduction-phenomenon"];

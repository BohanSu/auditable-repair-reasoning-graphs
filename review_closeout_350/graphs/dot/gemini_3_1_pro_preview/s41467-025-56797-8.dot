  "Node_13" -> "R6" [label="abduction-phenomenon"];
  "Node_12" -> "R6" [label="abduction-knowledge"];
  "R5" -> "R7" [label="abduction-phenomenon"];
  "R6" -> "R7" [label="abduction-knowledge"];
  "R7" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];

digraph ReasoningTree {
  // paper_id=s41467-025-56856-0
  rankdir="TB";
  "N1" [label="(1,0,0) PCR is widely used for selective amplification of target oligonucleotides identified by specific primer sequences."];
  "N10" [label="(0,0,0) Induction-case: PCR and related methods require long unique regions (~20 nt per primer, 40 nt total) for each subset. Induction-common: If a method requires proportionally increasing resources with scale, then it has limited scalability. Inductive reasoning: Current oligo selection methods require proportionally increasing primer synthesis and sequence length with subset number, therefore they have fundamentally limited scalability."];
  "N14" [label="(12,0,0) A highly efficient method for selecting oligo subsets can recognize barcodes in single-nucleotide resolution, eliminating the need for individual primers for each subset."];
  "N16" [label="(16,0,0) Theoretically, 4^N oligo subsets can be encoded by N nucleotides, with four possible bases per nucleotide."];
  "N20" [label="(18,0,0) The proposed method allows oligo subset selection in a hierarchical manner."];
  "N21" [label="(19,0,0) The synthesis-and-selection approach involves cyclic reactions, allowing higher hierarchy groups to be selected with fewer cycles."];
  "N24" [label="(30,0,0) During synthesis and selection, nucleotides matching the target directory use reversible terminators (3'-O-azidomethyl deoxynucleotides), while others use irreversible terminators (dideoxynucleotides)."];
  "N25" [label="(31,0,0) By repeating cycles after deprotecting reversible terminators, only oligos with target barcodes are retrieved."];
  "N3" [label="(3,0,0) For effective PCR, each target subset must possess a unique selection region for primer pairs (~20 nt) to ensure specificity."];
  "N4" [label="(4,0,0) Despite advancements in primer design and molecular probes, oligo selection specificity still largely depends on the length of the unique hybridization region."];
  "N5" [label="(5,0,0) Users must identify selection regions and synthesize corresponding primer pairs, with synthesis burden increasing proportionally to the number of subsets."];
  "N6" [label="(6,0,0) Other nucleic acid methods (hybridization-based capture, CRISPR) also rely on hybridization and share dependency on unique selection region length."];
  "N7" [label="(8,0,0) Given the 200 nt limit for de novo oligo synthesis, dedicating 40 nt to selection region regardless of subset number is inefficient."];
  "N8" [label="(9,0,0) To prevent library depletion during repeated selection, oligo library amplification requires an additional 40 nt replication region for universal primers."];
  "N9" [label="(11,0,0) Multiplexed PCR aims to select multiple oligo subsets in a single reaction, but primer synthesis requirement increases proportionally with target subsets, posing a bottleneck."];
  "NROOT" [label="(0,0,0) The paper aims to develop and evaluate a cyclic synthesis-and-selection technique that reads short N-nt barcodes at single-nucleotide resolution using reversible and irreversible terminators, enabling hierarchical retrieval of oligo subsets from complex DNA libraries while reducing dependence on individual primer pairs.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When existing oligo-selection methods scale poorly because they require long or subset-specific primer regions, a method that uses compact barcodes and selective cyclic chemistry is a plausible research direction for scalable subset retrieval."];
  "R2" [label="(0,0,0) Current oligo-selection workflows can devote substantial non-payload sequence capacity to selection and replication functions, because selection regions and universal replication regions both consume bases within the limited oligo synthesis length."];
  "R3" [label="(0,0,0) If oligo selection depends on long unique hybridization or primer requirements that scale one-to-one with requested subsets, that dependence plausibly explains the scalability bottleneck of PCR-like subset selection and motivates alternatives that do not require a separate primer design for each subset."];
  "R4" [label="(0,0,0) Because PCR-based oligo selection identifies targets through specific primer sequences, overcoming the primer-scaling bottleneck motivates a selection strategy that avoids requiring individual primer pairs for every oligo subset."];
  "R5" [label="(0,0,0) Single-nucleotide-resolution barcode recognition can encode many oligo subsets with short N-nt barcodes, since N barcode positions theoretically distinguish 4^N subsets and even 6 nt can identify thousands of subsets, reducing the need for unique primer pairs per subset."];
  "R6" [label="(0,0,0) A cyclic synthesis-and-selection approach supports hierarchical retrieval of oligo subsets, because the proposed method selects subsets hierarchically and cyclic reactions allow higher-level groups to be accessed with fewer cycles."];
  "R7" [label="(0,0,0) Using reversible terminators for nucleotides that match the target barcode and irreversible terminators for non-matching nucleotides enables selective continuation of matching oligos through repeated cycles while blocking non-matching oligos."];
  "R8" [label="(0,0,0) These observations support developing and evaluating a synthesis-and-selection-based oligo subset retrieval method for complex DNA libraries that uses short N-nt barcodes, single-nucleotide-resolution cyclic synthesis, and reversible versus irreversible terminators to reduce reliance on individual primer pairs and enable hierarchical retrieval."];
  "N3" -> "N10" [label="induction-case"];
  "N5" -> "N10" [label="induction-case"];
  "N4" -> "N10" [label="induction-case"];
  "N6" -> "N10" [label="induction-common"];
  "N7" -> "R2" [label="deduction-rule"];
  "N8" -> "R2" [label="deduction-case"];
  "N10" -> "R3" [label="abduction-phenomenon"];
  "N9" -> "R3" [label="abduction-knowledge"];
  "R3" -> "R4" [label="deduction-rule"];
  "N1" -> "R4" [label="deduction-case"];
  "N16" -> "R5" [label="induction-case"];
  "N14" -> "R5" [label="induction-common"];
  "N20" -> "R6" [label="abduction-phenomenon"];
  "N21" -> "R6" [label="abduction-knowledge"];
  "N25" -> "R7" [label="deduction-rule"];
  "N24" -> "R7" [label="deduction-case"];
  "R5" -> "R8" [label="induction-case"];
  "R4" -> "R8" [label="induction-common"];
  "R2" -> "NROOT" [label="induction-case"];
  "R6" -> "NROOT" [label="induction-case"];
  "R7" -> "NROOT" [label="induction-case"];
  "R8" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

digraph ReasoningTree {
  rankdir="TB";
  "I2" [label="(0,0,0) Induction-reasoning: Peptides targeting beta-lactamases show specificity, and targeting can be highly specific in general, so APR-based peptides can achieve high specificity."];
  "I3" [label="(0,0,0) Deduction-reasoning: APRs are in regions with low mutation rates, and if APRs are in such regions then targeting them reduces resistance likelihood, so targeting APRs reduces resistance development."];
  "I5" [label="(0,0,0) Abduction-reasoning: Bacterial membrane homeostasis is a known antibiotic target, and if membrane protein folding is disrupted it could affect membrane homeostasis, so disrupting membrane protein folding could yield broad-spectrum antibacterial activity."];
  "N12" [label="(15,0,0) Most proteins have at least one APR in their sequence and targeting can be highly specific."];
  "N13" [label="(16,0,0) APRs are typically located in hydrophobic cores or transmembrane regions where mutation rates are intrinsically low."];
  "N14" [label="(0,0,0) Deduction-rule: If APRs are in regions with low mutation rates, then targeting APRs reduces the likelihood of resistance development."];
  "N15" [label="(17,0,0) Peptides targeting beta-lactamases exhibit conditional toxicity in the presence of beta-lactam antibiotics."];
  "N16" [label="(18,0,0) These peptides can differentiate between related beta-lactamase classes whose APRs differ by a few amino acids."];
  "N18" [label="(20,0,0) This strategy aims to reduce the impact of single resistance-conferring mutations and cause widespread aggregation leading to proteostatic collapse."];
  "N19" [label="(0,0,0) Induction-common: Targeting multiple proteins simultaneously is a general principle for reducing resistance development."];
  "N20" [label="(21,0,0) Bacterial membrane homeostasis is a known target for broad-spectrum antibiotics."];
  "N21" [label="(0,0,0) Abduction-knowledge: If membrane protein folding is disrupted, it could affect membrane homeostasis."];
  "N27" [label="(28,0,0) A lack of resistance build-up against P33 was observed in E. coli, including in hypermutating strains, consistent with a mode of action involving multiple targets."];
  "N30" [label="(45,0,0) P33 showed broad-spectrum activity against other ESKAPE pathogens with conserved targets and a conserved mode of action."];
  "NROOT" [label="(0,0,0) This study proposes to develop and evaluate the engineered aggregation-prone peptide P33, composed of a tandem repeat of a conserved transmembrane aggregation-prone region, as a broad-spectrum antibiotic approach that targets essential bacterial proteins, especially membrane components and ribosomal components, to collapse proteostasis in ESKAPE pathogens while minimizing resistance development.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When a candidate antimicrobial design combines a defined engineered peptide architecture, APR-mediated multi-protein aggregation, disruption of bacterial proteostasis, broad pathogen activity, and evidence suggesting reduced resistance, those lines of evidence jointly support a research program to develop and evaluate that candidate as a broad-spectrum antibiotic strategy."];
  "R10" [label="(0,0,0) P33's broad-spectrum activity against ESKAPE pathogens with conserved targets is consistent with an antibacterial mechanism involving conserved target aggregation and disruption of membrane-related proteostasis."];
  "R11" [label="(0,0,0) P33 combines observed lack of resistance build-up in E. coli with aggregation of many proteins, supporting its interpretation as a multi-target aggregation strategy for limiting resistance development."];
  "R4" [label="(0,0,0) A strategy that deliberately aggregates multiple bacterial proteins is motivated as a way to reduce the impact of single resistance-conferring mutations while promoting proteostatic collapse."];
  "N15" -> "I2" [label="induction-case"];
  "N16" -> "I2" [label="induction-case"];
  "N12" -> "I2" [label="induction-common"];
  "N13" -> "I3" [label="deduction-case"];
  "N14" -> "I3" [label="deduction-rule"];
  "N20" -> "I5" [label="abduction-phenomenon"];
  "N21" -> "I5" [label="abduction-knowledge"];
  "N18" -> "R4" [label="induction-case"];
  "N19" -> "R4" [label="induction-common"];
  "N30" -> "R10" [label="abduction-phenomenon"];
  "I5" -> "R10" [label="abduction-knowledge"];
  "N27" -> "R11" [label="induction-case"];
  "N18" -> "R11" [label="induction-common"];
  "I2" -> "NROOT" [label="induction-case"];
  "I3" -> "NROOT" [label="induction-case"];
  "R10" -> "NROOT" [label="induction-case"];
  "R11" -> "NROOT" [label="induction-case"];
  "R4" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

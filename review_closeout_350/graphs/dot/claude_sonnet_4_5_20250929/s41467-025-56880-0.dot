  "E3" [label="(40,1,0) During apical constriction of mesoderm epithelial cells, the cell nuclei migrate basally."];
  "E4" [label="(43,1,0) The nucleus functions as a cellular compartmentalizer."];
  "E5" [label="(43,2,0) The relocation of the nucleus spatio-temporally organizes the cell cytoskeleton."];
  "E6" [label="(43,3,0) The relocation of the nucleus organizes the distribution of RhoGEF2."];
  "E7" [label="(8,1,0) Mesoderm epithelial cells establish two junctional tiers."];
  "E8" [label="(10,1,0) The second junctional tier is positioned laterally."];
  "E9" [label="(10,2,0) The second junctional tier is planar cell polarized."];
  "E10" [label="(10,3,0) The second junctional tier initiates cell intercalation for tissue convergence-extension."];
  "E11" [label="(14,1,0) The second junctional tier is formed by coalescence of the cell lateral actomyosin network."];
  "E12" [label="(24,1,0) The lateral pool of MyoII drives cell intercalation."];

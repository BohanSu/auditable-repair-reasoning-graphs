digraph ReasoningTree {
  rankdir="TB";
  "I1" [label="(0,0,0) Inductive reasoning: SECS face high-frequency error limitations, and dual Shapiro steps have flatness debates and charge fluctuation control issues. Therefore, mesoscopic current sources have inherent accuracy limitations at practical current levels."];
  "N1" [label="(1,0,0) The 2019 SI revision defines the ampere based on fixed constants e and f, enabling any current source expressible as ef to realize the ampere."];
  "N13" [label="(11,0,0) If quantized voltage is accurately applied to a quantum Hall resistance standard (ν=2), n_J·e charges are transferred at rate f_J through the QHRS of h/2e^2 resistance."];
  "N14" [label="(0,0,0) Deductive rule: If quantized voltage V = n_J·ϕ_0·f_J is applied to quantized resistance R = h/2e^2, then by Ohm's law, a quantized current I = V/R = n_J·e·f_J is generated."];
  "N18" [label="(0,0,0) Abductive phenomenon: The combined quantum standards approach achieved 1.3×10^-7 uncertainty but required very low ammeter resistance and faced connection accuracy issues."];
  "N19" [label="(0,0,0) Abductive knowledge: If connection imperfections between quantum standards introduce systematic errors, then improved connection methods could eliminate these errors and achieve better accuracy."];
  "N2" [label="(1,2,6) The new SI ampere definition based on elementary charge e will particularly impact electrical metrology."];
  "N24" [label="(0,0,0) Abductive phenomenon: PQCG achieved 10^-8 uncertainty in milliampere range but required corrections of order 10^-7 from non-ideal connections, impairing simplicity and potential."];
  "N25" [label="(0,0,0) Abductive knowledge: If a three-terminal connection of QHRS allows highly-accurate application of Josephson voltage to quantized resistance, then corrections from connection imperfections can be eliminated."];
  "N27" [label="(0,0,0) Deductive rule: If three-terminal QHRS connection eliminates connection imperfections, then a PQCG using this connection can deliver currents at theoretical quantized values without classical corrections."];
  "N3" [label="(2,0,0) Single-electron current sources (SECS) can handle electrons one by one at rate f_e and are presented as the most obvious way to realize the ampere."];
  "N4" [label="(3,0,0) Achieving currents above 100 pA using SECS with relative uncertainty better than 10^-7 remains challenging due to increasing error rates at high frequencies (~1 GHz)."];
  "N5" [label="(4,0,0) Dual Shapiro steps have been evidenced in superconducting nanowires and small Josephson junctions in high impedance environments under microwave radiation."];
  "N6" [label="(6,0,0) Sharp current steps at integer multiples of 2ef_e could be promising quantum sources in the nanoampere range, but their flatness is still in debate."];
  "N7" [label="(7,0,0) For all mesoscopic current sources, control of charge fluctuations dependent on device coupling with the electromagnetic environment remains a crucial issue."];
  "N8" [label="(0,0,0) Inductive common pattern: Multiple mesoscopic approaches (SECS and dual Shapiro steps) face fundamental challenges in achieving high accuracy at practical current levels."];
  "NROOT" [label="(0,0,0) Investigate, develop, and evaluate a next-generation programmable quantum current generator that combines Josephson voltage standards, quantum Hall resistance standards, a three-terminal QHRS connection, and superconducting-amplifier stabilization to realize correction-free, lower-noise SI ampere currents set by Josephson frequency from the microampere to milliampere ranges with uncertainties below 10^-8.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When existing quantum-current approaches are limited by accuracy, noise, or connection-related corrections, integrating Josephson and quantum Hall standards with an improved connection architecture motivates a next-generation ampere-realization experiment."];
  "R3" [label="(0,0,0) When a quantized Josephson voltage is applied to the ν=2 quantum Hall resistance, Ohm's law gives a quantized current I = n_J·e·f_J."];
  "R4" [label="(0,0,0) The earlier combination of Josephson and quantum Hall standards was limited by connection-related accuracy requirements, so improving the connection method is a plausible route to higher-accuracy current realization."];
  "R5" [label="(0,0,0) Because prior PQCG performance was impaired by corrections from non-ideal connections, a three-terminal QHRS connection that accurately applies Josephson voltage to quantized resistance can eliminate those connection-related corrections."];
  "R6" [label="(0,0,0) A PQCG using a three-terminal QHRS connection can deliver currents at theoretical quantized values without classical corrections from connection imperfections."];
  "N3" -> "I1" [label="induction-case"];
  "N4" -> "I1" [label="induction-case"];
  "N5" -> "I1" [label="induction-case"];
  "N6" -> "I1" [label="induction-case"];
  "N7" -> "I1" [label="induction-case"];
  "N8" -> "I1" [label="induction-common"];
  "N1" -> "I1" [label="induction-case"];
  "N2" -> "I1" [label="induction-case"];
  "N14" -> "R3" [label="deduction-rule"];
  "N13" -> "R3" [label="deduction-case"];
  "N18" -> "R4" [label="abduction-phenomenon"];
  "N19" -> "R4" [label="abduction-knowledge"];
  "N24" -> "R5" [label="abduction-phenomenon"];
  "N25" -> "R5" [label="abduction-knowledge"];
  "N27" -> "R6" [label="deduction-rule"];
  "R5" -> "R6" [label="deduction-case"];
  "I1" -> "NROOT" [label="induction-case"];
  "R3" -> "NROOT" [label="induction-case"];
  "R4" -> "NROOT" [label="induction-case"];
  "R6" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

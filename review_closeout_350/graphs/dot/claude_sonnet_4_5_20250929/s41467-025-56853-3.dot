  "N12" [label="(12,0,0) Notable transcript-protein inconsistencies observed in AD and 5xFAD mice"];
  "N14" [label="(14,0,0) Early proteomic studies were limited by inadequate depth, restricted model analysis, and insufficient human comparison"];

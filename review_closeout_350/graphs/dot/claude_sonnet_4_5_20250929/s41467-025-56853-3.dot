  "I5_rule" [label="(0,0,0) Rule: If previous studies had specific limitations, then addressing those limitations requires a more comprehensive approach"];
  "I6_knowledge" [label="(0,0,0) Knowledge: Protein degradation rates affect steady-state protein levels independently of synthesis"];
  "N10" [label="(10,0,0) Transcriptomic analyses revealed changes in immune response, synaptic function, and neuronal signaling genes"];

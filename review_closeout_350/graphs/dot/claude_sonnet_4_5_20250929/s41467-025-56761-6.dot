digraph ReasoningTree {
  rankdir="TB";
  "NROOT" [label="(0,0,0) The paper investigates whether Lon protease released when E. coli cells die degrades co-released cellular proteins into small peptides that surviving bacteria can use, thereby enabling post-mortem nutrient recycling and promoting bacterial growth under nutrient-limited conditions.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) Together, evidence that bacteria use small peptides as nutrients, proteins require prior degradation, dead bacteria release proteins, and released proteases can generate bioavailable peptides supports investigating Lon-mediated post-mortem nutrient recycling."];
  "R6" [label="(0,0,0) The growth-enhancing effect of pre-degraded protein in minimal medium motivates the hypothesis that environmental protein degradation to small peptides can support bacterial growth in nature."];
  "R7" [label="(0,0,0) Because proteins released from dead bacteria must be catabolized to small peptides before supporting live-cell growth, co-released proteases from dead bacteria are plausible agents to investigate for generating bioavailable nutrients."];
  "R8" [label="(0,0,0) If Lon protease released from dead cells degrades co-released proteins into small peptide nutrients, then Lon protease can enable nutrient recycling from dead bacterial proteins."];
  "implicit2" [label="(0,0,0) Induction-common: If bacteria transport small peptides as nitrogen and amino acid sources, then small peptides are a general class of nutrients that bacteria can utilize."];
  "implicit4" [label="(0,0,0) Abduction-knowledge: If casein hydrolysate (pre-degraded protein) enhances bacterial growth, then protein degradation to small peptides is necessary for proteins to serve as bacterial nutrients."];
  "implicit5" [label="(0,0,0) Deduction-rule: If environmental proteins require degradation to small peptides for bacterial uptake, then proteins from dead bacteria must also be degraded to small peptides before supporting growth of live cells."];
  "implicit6" [label="(0,0,0) Deduction-case: In natural environments, dead bacteria release proteins through lysis."];
  "implicit7" [label="(0,0,0) Induction-common: If laboratory protein degradation (casein hydrolysate) supports bacterial growth, then environmental protein degradation should similarly support bacterial growth in nature."];
  "implicit8" [label="(0,0,0) Abduction-knowledge: If dead bacteria release both proteins and proteases during lysis, then co-released proteases could degrade co-released proteins to create bioavailable nutrients."];
  "implicit9" [label="(0,0,0) Deduction-rule: If a protease from dead cells degrades co-released proteins to small peptides, then it enables nutrient recycling from dead bacterial proteins."];
  "node3_2" [label="(3,2,0) Deduction-case: Small peptides serve as a source of fixed nitrogen for bacteria."];
  "node5_1" [label="(5,1,0) Deduction-rule: If whole proteins are typically too large for bacterial uptake, then prior degradation is necessary."];
  "node5_2" [label="(5,2,0) Deduction-case: Whole proteins are typically too large for bacterial uptake."];
  "node6_1" [label="(6,1,0) Abduction-phenomenon: Casein hydrolysate gives a dose-dependent enhancement of wild-type Escherichia coli growth when used as an additive to minimal media."];
  "node7_1" [label="(7,1,0) Abduction-phenomenon: Proteins released from dead bacteria must be catabolized to small peptides before supporting growth of live cells."];
  "node8_1" [label="(8,2,0) Deduction-case: Lon protease is released from dead cells and catalyzes co-released proteins into small peptide nutrients."];
  "reason2" [label="(0,0,0) Induction-reasoning: Given that bacteria transport small peptides as nitrogen and amino acid sources, and if small peptides serve these functions then small peptides are a general nutrient class, therefore small peptides are a key nutrient form for bacteria."];
  "reason3" [label="(0,0,0) Deduction-reasoning: Given that whole proteins are too large for bacterial uptake, and if proteins are too large then prior degradation is necessary, therefore proteins must be degraded to small peptides before bacterial uptake."];
  "reason4" [label="(0,0,0) Abduction-reasoning: Given that casein hydrolysate enhances bacterial growth (phenomenon), and if protein degradation to small peptides is necessary for nutrient availability (knowledge), therefore protein degradation to small peptides is required for proteins to serve as bacterial nutrients."];
  "reason5" [label="(0,0,0) Deduction-reasoning: Given that dead bacteria release proteins in the environment, and if environmental proteins require degradation to small peptides for uptake, therefore proteins from dead bacteria must be degraded to small peptides before supporting live cell growth."];
  "node3_2" -> "reason2" [label="induction-case"];
  "implicit2" -> "reason2" [label="induction-common"];
  "node5_2" -> "reason3" [label="deduction-case"];
  "node5_1" -> "reason3" [label="deduction-rule"];
  "node6_1" -> "reason4" [label="abduction-phenomenon"];
  "implicit4" -> "reason4" [label="abduction-knowledge"];
  "implicit6" -> "reason5" [label="deduction-case"];
  "implicit5" -> "reason5" [label="deduction-rule"];
  "reason4" -> "R6" [label="induction-case"];
  "implicit7" -> "R6" [label="induction-common"];
  "node7_1" -> "R7" [label="abduction-phenomenon"];
  "implicit8" -> "R7" [label="abduction-knowledge"];
  "implicit9" -> "R8" [label="deduction-rule"];
  "node8_1" -> "R8" [label="deduction-case"];
  "R6" -> "NROOT" [label="induction-case"];
  "R7" -> "NROOT" [label="induction-case"];
  "R8" -> "NROOT" [label="induction-case"];
  "reason2" -> "NROOT" [label="induction-case"];
  "reason3" -> "NROOT" [label="induction-case"];
  "reason5" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

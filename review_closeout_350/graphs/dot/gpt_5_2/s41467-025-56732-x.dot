  "C7" -> "NROOT" [label="induction-case"];
  "C8" -> "NROOT" [label="induction-case"];
  "R1" -> "NROOT" [label="induction-case"];
  "R13" -> "NROOT" [label="induction-case"];
  "R14" -> "NROOT" [label="induction-case"];

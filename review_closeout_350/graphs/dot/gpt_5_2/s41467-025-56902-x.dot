digraph ReasoningTree {
  rankdir="TB";
  "NROOT" [label="(0,0,0) Rationally design and evaluate quinoline analogs that occupy the Val70Ub pocket of SARS-CoV-2 papain-like protease to generate potent noncovalent PLpro inhibitors, prioritizing lead compound Jun13296 because the reported enzymatic efficacy, cellular antiviral efficacy, and oral in-vivo antiviral efficacy support its further development as a COVID-19 therapy candidate.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) A COVID-19 antiviral development proposal is strengthened when a validated viral target, a rational binding-site design strategy, and convergent enzymatic, cellular, and in-vivo efficacy evidence all point to the same lead compound."];
  "N_i_feasibility_noncov" [label="(0,0,0) deduction-reasoning: Given the rule that validated binding and in vivo efficacy demonstrate feasibility of a noncovalent inhibitor series, and the case that Jun12682 binds a validated site and shows in vivo efficacy, therefore noncovalent PLpro inhibitors are a feasible development path."];
  "N_i_plpro_target_support" [label="(0,0,0) induction-reasoning: Given multiple PLpro functional roles and a common pattern that multifunctional viral enzymes are high-value antiviral targets, therefore PLpro is a high-value antiviral target to prioritize."];
  "N_r22_1" [label="(0,0,0) If an enzyme is essential for SARS-CoV-2 replication and is a promising drug target, then inhibiting it is a plausible antiviral strategy."];
  "N_s17" [label="(17,0,0) Currently, the Mpro L50F/E166A/L167F triple mutant can show high drug resistance while maintaining similar replication fitness in cell culture and animals."];
  "N_s20" [label="(20,0,0) Currently, PLpro (part of nsp3) cleaves viral polyproteins at multiple junctions (nsp1/2, nsp2/3, nsp3/4)."];
  "N_s21" [label="(21,0,0) Currently, PLpro removes ubiquitin/ISG15 from host proteins (deubiquitinase/deISGylase), antagonizing host immune responses."];
  "N_s24" [label="(24,0,0) Currently, GRL0617 (and its analogs) are major noncovalent PLpro inhibitors with a validated mechanism of action."];
  "N_s25" [label="(25,0,0) Currently, a first-in-class rationally designed noncovalent PLpro inhibitor Jun12682 showed in vivo antiviral efficacy in a SARS-CoV-2 mouse model."];
  "N_s26" [label="(26,0,0) Currently, Jun12682 binds the same PLpro site as GRL0617 in the BL2 region."];
  "N_s27" [label="(27,0,0) Currently, Jun12682 extends into a previously unexplored PLpro binding site (Val70Ub), and this extension accounts for its high potency."];
  "N_s28" [label="(28,0,0) Currently, the work proposes designing a series of quinoline analogs to target the Val70Ub site."];
  "N_s29" [label="(29,0,0) Currently, X-ray structures show most designed leads occupy Val70Ub as expected, but one lead (Jun12665) can flip and instead fit a BL2-groove orientation."];
  "N_s31" [label="(31,0,0) Currently, in a SARS-CoV-2 mouse model, oral Jun13296 yields improved in vivo antiviral efficacy versus Jun12682."];
  "N_s32" [label="(32,0,0) Currently, Jun13296 is presented as a promising PLpro antiviral drug candidate for further development."];
  "N_s9" [label="(9,0,0) Currently, additional antivirals with alternative mechanisms are needed because some viruses lack antivirals or because resistance issues can arise with existing antivirals."];
  "R2" [label="(0,0,0) Given the rule that a promising SARS-CoV-2 enzyme can be a plausible antiviral inhibition target, and given that PLpro is supported as a high-value viral enzyme target, inhibiting SARS-CoV-2 PLpro is a plausible antiviral strategy to pursue."];
  "R3" [label="(0,0,0) Jun12682's potency-associated extension into the Val70Ub pocket makes Val70Ub engagement a plausible design hypothesis for improving noncovalent SARS-CoV-2 PLpro inhibitors, without by itself proving that every new scaffold will be potent."];
  "R4" [label="(0,0,0) Because Val70Ub engagement is a plausible PLpro inhibitor design hypothesis and the work proposes quinoline analogs to target the Val70Ub site, the study should design and test quinoline analogs with structural and activity assays to assess binding mode and potency."];
  "R7" [label="(0,0,0) Evidence that nirmatrelvir-resistant SARS-CoV-2 mutants can retain replication fitness supports the need to pursue antivirals with alternative mechanisms or targets."];
  "R8" [label="(0,0,0) The designed quinoline series provides evidence consistent with Val70Ub-targeted analog design advancing PLpro inhibitors: structures show most designed leads occupy Val70Ub as expected, and Jun13296 shows stronger enzymatic inhibition and cellular antiviral activity than Jun12682."];
  "N_s20" -> "N_i_plpro_target_support" [label="induction-case"];
  "N_s21" -> "N_i_plpro_target_support" [label="induction-common"];
  "N_s26" -> "N_i_feasibility_noncov" [label="deduction-case"];
  "N_s25" -> "N_i_feasibility_noncov" [label="deduction-rule"];
  "N_s25" -> "N_s32" [label="induction-case"];
  "N_s31" -> "N_s32" [label="induction-common"];
  "N_r22_1" -> "R2" [label="deduction-rule"];
  "N_i_plpro_target_support" -> "R2" [label="deduction-case"];
  "N_s27" -> "R3" [label="abduction-phenomenon"];
  "N_s24" -> "R3" [label="abduction-knowledge"];
  "R3" -> "R4" [label="deduction-rule"];
  "N_s28" -> "R4" [label="deduction-case"];
  "N_s9" -> "R7" [label="deduction-rule"];
  "N_s17" -> "R7" [label="deduction-case"];
  "N_s29" -> "R8" [label="induction-case"];
  "R3" -> "R8" [label="induction-common"];
  "N_i_feasibility_noncov" -> "NROOT" [label="induction-case"];

  "N20" -> "N21" [label="abduction-phenomenon"];
  "N19" -> "N21" [label="abduction-knowledge"];
  "N19" -> "N22" [label="deduction-rule"];
  "N18" -> "N22" [label="deduction-case"];
  "N5" -> "N5X" [label="induction-case"];

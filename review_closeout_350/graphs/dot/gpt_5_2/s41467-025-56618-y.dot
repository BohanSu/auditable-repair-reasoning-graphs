digraph ReasoningTree {
  rankdir="TB";
  "A1" [label="(0,0,0) deduction-reasoning: Given SRT captures high-resolution spatial organisation of genes and high-resolution spatial gene-heterogeneity information enables discovery/understanding, therefore SRT can enable discovery/understanding of complex biology."];
  "A1_case" [label="(1,1,0) Currently SRT captures spatial organisation of genes in tissues at high resolution."];
  "A1_rule" [label="(0,0,0) If a technology yields high-resolution spatial gene-heterogeneity information, then it can enable discovery of key genes/pathways and help understand complex biological processes."];
  "A2" [label="(0,0,0) deduction-reasoning: Given SRT has enabled identification of key genes/pathways and identifying key genes/pathways implies actionable molecular insight, therefore SRT provides actionable molecular insight."];
  "A2_case" [label="(2,1,0) Currently SRT has enabled identification of key genes involved in intricate mechanisms underlying diverse biological processes."];
  "A2_rule" [label="(0,0,0) If SRT enables identification of key genes/pathways in complex phenomena, then SRT provides actionable molecular insight for research (and potentially for disease understanding)."];
  "A5" [label="(0,0,0) deduction-reasoning: Given ML with SRT information can predict in silico spatial gene expression from paired H&E and if that implies H&E can be enriched with molecular information, therefore H&E can be enriched with molecular SGE information in silico."];
  "A5_case" [label="(5,1,0) Currently leveraging modern machine learning together with information from SRT can help predict in silico spatial gene expression profiles from paired histology images of the same tissue."];
  "A5_rule" [label="(0,0,0) If modern machine learning can use paired SRT+H&E to predict spatial gene expression profiles, then H&E images can be enriched with molecular (SGE) information in silico."];
  "A6" [label="(0,0,0) deduction-reasoning: Given large-scale examination of spatial gene-expression variation can lead to biomarker discovery and in-silico SGE enrichment enables such examinations, therefore in-silico SGE-from-H&E can enable biomarker/target discovery."];
  "A6_case" [label="(6,1,0) Currently facilitating large-scale examinations of spatial gene expression variations can lead to discovery of biomarkers for complex diseases."];
  "A6_rule" [label="(0,0,0) If in-silico SGE enriches H&E with molecular information, then it facilitates large-scale study of spatial gene-expression variation and biomarker/target discovery."];
  "ABD1" [label="(0,0,0) abduction-reasoning: Given an incomplete understanding of stability and background knowledge that limited/non-independent/inconsistent evaluations cause such incompleteness, therefore the best explanation is the absence of a comprehensive independent benchmark (and such a benchmark is needed)."];
  "ABD1_kn" [label="(0,0,0) If evaluations are limited, non-independent, and inconsistent, then stability/generalizability knowledge will be incomplete; a comprehensive independent benchmark would explain and address this gap."];
  "ABD1_ph" [label="(27,2,0) Currently we lack a comprehensive understanding of the stability of individual SGE-from-H&E methods."];
  "ABD2" [label="(0,0,0) abduction-reasoning: Given missing evaluation of H&E spatial characteristics and background knowledge that benchmarks lacking such categories cause this, therefore the best explanation is the absence of benchmark categories/metrics for H&E spatial characteristics and downstream impact (and they should be included)."];
  "ABD2_kn" [label="(0,0,0) If benchmarks focus only on aggregate predictive metrics without stratifying by image spatial characteristics and downstream analyses, then such effects will remain unevaluated; adding dedicated benchmark categories/metrics would address it."];
  "ABD2_ph" [label="(28,1,0) Currently there is a lack of critical evaluation of how different spatial characteristics of H&E images affect SGE prediction accuracy and downstream/clinical translation."];
  "A_motive" [label="(0,0,0) deduction-reasoning: Given predicting SGE from H&E has clinical potential and if clinically impactful tasks require reliable evidence about method performance/stability/generalizability, therefore reliable evaluation/benchmarking is needed for SGE-from-H&E methods."];
  "A_motive_case" [label="(33,1,0) Currently ongoing development in predicting SGE from H&E provides exciting potential for clinical usage."];
  "A_motive_rule" [label="(0,0,0) If a task is clinically attractive and impactful, then the community needs reliable evidence about which methods work, how stable/generalizable they are, and when to use them."];
  "B1" [label="(0,0,0) deduction-reasoning: Given several distinct approaches exist and multiple approaches imply the need for comparative benchmarking to understand trade-offs, therefore benchmarking is needed."];
  "B1_case" [label="(7,1,0) Currently several approaches have been developed to predict in silico SGE patterns using H&E data alone."];
  "B1_rule" [label="(0,0,0) If multiple distinct approaches exist for the same prediction task, then comparative benchmarking becomes necessary to understand trade-offs and select methods."];
  "B2" [label="(0,0,0) deduction-reasoning: Given some methods use GNN (showing architectural/component diversity) and if such diversity implies evaluation must cover diverse capabilities, therefore benchmarking should evaluate neighborhood/spatial-structure handling (and other component-driven differences)."];
  "B2_case" [label="(9,2,0) Currently some methods implement Graph Neural Networks (GNN) to capture neighbourhood relationships between adjacent spots."];
  "B2_rule" [label="(0,0,0) If methods use different model architectures/components (e.g., CNN/Transformer/GNN/super-resolution/exemplars), then evaluation must cover diverse capabilities (local/global features, neighborhood structure, resolution, exemplar guidance)."];
  "C1" [label="(0,0,0) deduction-reasoning: Given methods are recent and if recent/rapidly evolving methods are unlikely to be comprehensively benchmarked, therefore comprehensive benchmarking is likely missing."];
  "C1_case" [label="(12,1,0) Currently methods predicting SGE have been published in the last 3 years."];
  "C1_rule" [label="(0,0,0) If methods are new/rapidly evolving, then their performance is unlikely to have been comprehensively benchmarked yet."];
  "C2" [label="(0,0,0) deduction-reasoning: Given evaluations are mainly developer-run and if developer-run evaluations imply limited/non-independent evidence, therefore the current evidence base is limited and not independent."];
  "C2_case" [label="(20,1,0) Currently methods predicting SGE from H&E have been mainly assessed/evaluated by their developers."];
  "C2_rule" [label="(0,0,0) If existing papers mainly provide developer-run evaluations, then evidence is limited and potentially non-independent."];
  "C3" [label="(0,0,0) deduction-reasoning: Given evaluation frameworks differ across papers and if differing frameworks imply poor comparability and no consistent detailed framework, therefore there is no consistent/detailed evaluation framework."];
  "C3_case" [label="(21,1,0) Currently different evaluation frameworks have been used to assess SGE-from-H&E methods."];
  "C3_rule" [label="(0,0,0) If different evaluation frameworks are used across papers, then results are not directly comparable and no consistent detailed framework exists."];
  "C4" [label="(0,0,0) deduction-reasoning: Given reviews lack benchmarking and if that implies quantitative comparative evidence is missing, therefore comparative evidence remains missing."];
  "C4_case" [label="(13,4,0) Currently general reviews have not included any benchmarking of methods predicting SGE from H&E."];
  "C4_rule" [label="(0,0,0) If general reviews only survey/categorize without benchmarking, then the community still lacks quantitative comparative evidence."];
  "C5" [label="(27,1,0) deduction-reasoning: Given there is no detailed evaluation framework and lack of such a framework implies lack of comprehensive understanding, therefore we lack comprehensive understanding of method performance/stability/applicability."];
  "C5_case" [label="(26,2,0) Currently there is no detailed evaluation framework comparing performance of SGE-from-H&E approaches."];
  "C5_rule" [label="(0,0,0) If there is no consistent and detailed evaluation framework, then we will lack a comprehensive understanding of performance, stability, and broader applicability of individual methods."];
  "D2" [label="(0,0,0) deduction-reasoning: Given 28 metrics in five categories are used and categorized metrics enable structured evaluation of diverse aspects, therefore the benchmark can evaluate diverse aspects in a structured way."];
  "D2_case" [label="(30,2,0) Currently the comparison used 28 different metrics broadly grouped into five categories."];
  "D2_rule" [label="(0,0,0) If we use a broad set of metrics grouped into categories, then we can evaluate different aspects (prediction accuracy, spatial fidelity, biological relevance, downstream utility, etc.) in a structured way."];
  "D3_case" [label="(31,1,0) Currently metrics include evaluation of spatial characteristics of genes that are predicted effectively."];
  "D3_rule" [label="(0,0,0) If evaluation aims to reflect biological and spatial validity, then metrics should assess spatial characteristics and biological characteristics of well-predicted genes."];
  "D4" [label="(0,0,0) deduction-reasoning: Given downstream-impact metrics are included and usefulness depends on downstream tasks, therefore including downstream-impact metrics supports assessing clinical/functional usefulness."];
  "D4_case" [label="(32,1,0) Currently metrics include the impact of prediction performance on downstream applications."];
  "D4_rule" [label="(0,0,0) If clinical/functional usefulness depends on downstream tasks, then benchmarking should include metrics for downstream application impact."];
  "E1_rule" [label="(0,0,0) If the task has high potential impact and existing evaluations are inconsistent/non-independent and lack comprehensive benchmarking, then we should conduct an independent comprehensive benchmark/review with a consistent detailed framework."];
  "E2_rule" [label="(0,0,0) If we should provide an independent comprehensive benchmark/review, then the concrete plan is to compare many methods with many metrics across categories including spatial/biological fidelity and downstream impact."];
  "F_rule" [label="(0,0,0) If a comprehensive independent benchmark is needed and we have a concrete multi-method/multi-metric evaluation design, then the resulting research proposal is to deliver a benchmark+review study implementing that design."];
  "NROOT" [label="(0,0,0) This study aims to benchmark and review machine-learning methods that predict spatially resolved gene expression from H&E histopathology images, using a consistent multi-method and multi-metric evaluation to assess accuracy, robustness, spatial and biological fidelity, and downstream translational relevance.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When a clinically promising SGE-from-H&E prediction task has rapidly developing methods, limited or inconsistent prior evaluation, and a structured multi-method/multi-metric benchmark design, the appropriate paper-level aim is to conduct and report such a benchmark/review."];
  "R22" [label="(0,0,0) The benchmark includes metrics evaluating spatial characteristics of effectively predicted genes, thereby covering the spatial-characteristic component relevant to spatial validity without by itself proving full biological validity."];
  "R24" [label="(0,0,0) Clinical potential, non-independent or inconsistent prior evaluations, absence of a consistent framework, and lack of prior benchmarking together support conducting an independent comprehensive benchmark/review."];
  "R25" [label="(0,0,0) Given the supported need for an independent comprehensive benchmark/review, the corresponding solution approach is a multi-method, multi-metric, multi-category evaluation design."];
  "R26" [label="(0,0,0) The core research idea is to deliver a benchmark and review of SGE-from-H&E prediction methods using a consistent, detailed multi-method and multi-metric evaluation design."];
  "A1_rule" -> "A1" [label="deduction-rule"];
  "A1_case" -> "A1" [label="deduction-case"];
  "A2_rule" -> "A2" [label="deduction-rule"];
  "A2_case" -> "A2" [label="deduction-case"];
  "A5_rule" -> "A5" [label="deduction-rule"];
  "A5_case" -> "A5" [label="deduction-case"];
  "A6_rule" -> "A6" [label="deduction-rule"];
  "A6_case" -> "A6" [label="deduction-case"];
  "A_motive_rule" -> "A_motive" [label="deduction-rule"];
  "A_motive_case" -> "A_motive" [label="deduction-case"];
  "B1_rule" -> "B1" [label="deduction-rule"];
  "B1_case" -> "B1" [label="deduction-case"];
  "B2_rule" -> "B2" [label="deduction-rule"];
  "B2_case" -> "B2" [label="deduction-case"];
  "C1_rule" -> "C1" [label="deduction-rule"];
  "C1_case" -> "C1" [label="deduction-case"];
  "C2_rule" -> "C2" [label="deduction-rule"];
  "C2_case" -> "C2" [label="deduction-case"];
  "C3_rule" -> "C3" [label="deduction-rule"];
  "C3_case" -> "C3" [label="deduction-case"];
  "C4_rule" -> "C4" [label="deduction-rule"];
  "C4_case" -> "C4" [label="deduction-case"];
  "C5_rule" -> "C5" [label="deduction-rule"];
  "C5_case" -> "C5" [label="deduction-case"];
  "ABD1_ph" -> "ABD1" [label="abduction-phenomenon"];
  "ABD1_kn" -> "ABD1" [label="abduction-knowledge"];
  "ABD2_ph" -> "ABD2" [label="abduction-phenomenon"];
  "ABD2_kn" -> "ABD2" [label="abduction-knowledge"];
  "D2_rule" -> "D2" [label="deduction-rule"];
  "D2_case" -> "D2" [label="deduction-case"];
  "D4_rule" -> "D4" [label="deduction-rule"];
  "D4_case" -> "D4" [label="deduction-case"];
  "D3_rule" -> "R22" [label="deduction-rule"];
  "D3_case" -> "R22" [label="deduction-case"];
  "A_motive" -> "R24" [label="induction-case"];
  "E1_rule" -> "R24" [label="induction-common"];
  "E2_rule" -> "R25" [label="deduction-rule"];
  "R24" -> "R25" [label="deduction-case"];
  "R24" -> "R26" [label="induction-case"];
  "F_rule" -> "R26" [label="induction-common"];
  "A1" -> "NROOT" [label="induction-case"];

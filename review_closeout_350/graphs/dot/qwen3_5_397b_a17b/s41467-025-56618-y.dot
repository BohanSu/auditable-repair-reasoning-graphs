digraph ReasoningTree {
  // paper_id=s41467-025-56618-y
  rankdir="TB";
  "N1" [label="(1,0,0) Currently SRT data captures spatial organisation and heterogeneity of genes."];
  "N10" [label="(8,0,0) Currently CNN and Transformers are commonly selected architectures."];
  "N11" [label="(9,0,0) Currently some methods implemented extra components like GNN."];
  "N12" [label="(10,0,0) Currently an exemplar module had been used to guide predictions."];
  "N14" [label="(12,0,0) Currently performance has not yet been comprehensively benchmarked."];
  "N15" [label="(13,0,0) Currently reviews have only surveyed methods without benchmarking."];
  "N16" [label="(19,0,0) Currently evaluation studies are limited and often not independent."];
  "N17" [label="(20,0,0) Currently methods have been mainly assessed by their developers."];
  "N18" [label="(21,0,0) Different evaluation frameworks have been used to assess the methods."];
  "N19" [label="(22,0,0) For instance, ST-Net and others evaluated on TCGA data."];
  "N2" [label="(2,0,0) Currently SRT has enabled identification of key genes and pathways."];
  "N20" [label="(23,0,0) Hist2ST and others performed ablation studies."];
  "N21" [label="(24,0,0) BrST-Net conducted a comparison of architectures."];
  "N22" [label="(25,0,0) iStar demonstrated application by tissue segmentation."];
  "N28" [label="(30,0,0) Currently we compared eleven methods using 28 metrics."];
  "N29" [label="(31,0,0) Currently metrics focus on spatial and biological characteristics."];
  "N3" [label="(3,0,0) Currently SRT technologies remain costly."];
  "N30" [label="(32,0,0) Currently metrics include impact on downstream applications."];
  "N31" [label="(33,0,0) Currently the study provides analysis of significant achievements."];
  "N32" [label="(34,0,0) Currently we provide assessment of limitations and generalisability."];
  "N33" [label="(35,0,0) Currently we offer guidance for users and highlight challenges."];
  "N34" [label="(36,0,0) Currently the study serves as a tool for future evaluation."];
  "N35" [label="(0,0,0) Induction-reasoning: Given SRT captures genes and enables identification, therefore SRT is valuable."];
  "N36" [label="(0,0,0) Deduction-reasoning: Given SRT is costly and if costly then not routine, therefore SRT is not routine."];
  "N38" [label="(0,0,0) Induction-reasoning: Given ML predicts SGE and facilitates discovery, therefore ML on H&E is beneficial."];
  "N39" [label="(0,0,0) Induction-reasoning: Given approaches developed and CNN used, therefore DL methods exist."];
  "N4" [label="(0,0,0) If technologies are costly, then they are prevented from routine clinical adoption."];
  "N40" [label="(0,0,0) Induction-reasoning: Given extra components and exemplar modules used, therefore methods are complex."];
  "N43" [label="(0,0,0) Induction-reasoning: Given limited studies and assessed by developers, therefore evaluation is biased."];
  "N44" [label="(0,0,0) Induction-reasoning: Given ST-Net evaluated on TCGA and Hist2ST did ablation, therefore specific methods vary."];
  "N5" [label="(4,0,0) Currently H&E images are cost-effective and routinely used."];
  "N54" [label="(0,0,0) Induction-reasoning: Given analysis of achievements and assessment of limitations, therefore comprehensive assessment."];
  "N6" [label="(0,0,0) If H&E is routine and SRT is costly, then leveraging H&E is a viable alternative."];
  "N7" [label="(5,0,0) Currently we can leverage ML to predict SGE from H&E."];
  "N8" [label="(6,0,0) Currently this would facilitate large-scale examinations and biomarker discovery."];
  "N9" [label="(7,0,0) Currently several approaches have been developed to predict SGE using H&E."];
  "NROOT" [label="(0,0,0) This paper proposes an independent benchmark of recent machine-learning methods for inferring spatially resolved gene expression from H&E histopathology images, comparing eleven methods with 28 spatial, biological, and application-oriented metrics to assess performance, robustness, limitations, and translational potential.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When costly SRT is not routinely adopted, ML-based prediction of spatially resolved gene expression from routine H&E images requires independent, consistent benchmarking across spatial, biological, and application-oriented criteria to assess performance, robustness, and translational usefulness."];
  "R11" [label="(0,0,0) Examples of H&E-to-SGE work include architecture comparisons and tissue-segmentation applications."];
  "R12" [label="(0,0,0) Reported examples differ in what they evaluate or apply, including TCGA evaluation, ablation studies, architecture comparison, and tissue segmentation."];
  "R13" [label="(0,0,0) Prior evaluation of H&E-to-SGE methods shows limitations because examples differ in evaluation/application focus and studies are limited, often not independent, and mainly developer assessed."];
  "R14" [label="(0,0,0) The limited and heterogeneous prior evaluation landscape, together with the use of different evaluation frameworks, indicates the absence of a consistent evaluation framework."];
  "R18" [label="(0,0,0) The evaluation metrics cover spatial and biological characteristics as well as impacts on downstream applications."];
  "R19" [label="(0,0,0) The study compares eleven methods using 28 metrics that include spatial, biological, and downstream application-oriented aspects."];
  "R21" [label="(0,0,0) The study offers guidance for users, highlights challenges, and can serve as a tool for future evaluation."];
  "R22" [label="(0,0,0) The study assesses achievements, limitations, and generalisability in the context of beneficial ML-based prediction of SGE from H&E images."];
  "R25" [label="(0,0,0) The literature lacks a comprehensive benchmark because performance has not yet been comprehensively benchmarked and reviews have mainly surveyed methods without benchmarking."];
  "R28" [label="(0,0,0) Because prior evaluations were limited and often not independent while this study compares eleven methods with 28 metrics, the study provides a benchmark-style assessment distinct from developer-only evaluations."];
  "R29" [label="(0,0,0) The study combines assessment of method achievements and limitations with practical guidance and an evaluation tool for future work."];
  "R3" [label="(0,0,0) H&E images are routinely used and cost-effective, while SRT technologies remain costly."];
  "R4" [label="(0,0,0) Given routine H&E imaging and costly SRT, leveraging H&E is a viable alternative direction."];
  "R8" [label="(0,0,0) Recent H&E-to-SGE approaches include deep-learning methods, and some methods incorporate additional components that make them technically complex."];

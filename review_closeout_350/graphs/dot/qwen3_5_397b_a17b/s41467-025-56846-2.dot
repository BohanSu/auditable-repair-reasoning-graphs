  "I20" [label="(0,0,0) Induction-Reasoning: Hierarchical assembly achieves size (S28, S29)."];
  "I21" [label="(0,0,0) Deduction-Reasoning: Hierarchical has control but challenges (S30, S31)."];
  "I22" [label="(0,0,0) Induction-Reasoning: Homomultimeric is cheap (S32, S33)."];
  "I23" [label="(0,0,0) Deduction-Reasoning: Homomultimeric loses control (S34, S35)."];
  "I24" [label="(0,0,0) Deduction-Reasoning: Homomultimeric trade-off (I22, I23)."];
  "I25" [label="(0,0,0) Induction-Reasoning: Heteromultimeric has control (S36, S37)."];

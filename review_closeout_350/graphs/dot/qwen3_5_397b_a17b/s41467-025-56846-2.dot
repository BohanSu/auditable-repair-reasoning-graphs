  "I10" [label="(0,0,0) Deduction-Reasoning: Scaffold length limits DON size (S13, I_Rule_DON_Limit)."];
  "I11" [label="(0,0,0) Deduction-Reasoning: DONs are attractive but limited (I9, I10)."];

  "I13" [label="(0,0,0) Deduction: Given violation consequences and phase requirements, therefore phase-matching is a critical condition for RPE success."];
  "I2" [label="(0,0,0) Induction: Given deep circuitry necessity and compounded inefficiency, therefore practical hurdles are severe."];
  "I4" [label="(0,0,0) Deduction: Given QEC accuracy demand and protocol shortfall, therefore there is an accuracy gap for QEC."];

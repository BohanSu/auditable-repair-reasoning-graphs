  "N25" [label="(17,1,0) Samples will be referred to by their Mn content: Mn40, Mn45, and Mn50."];
  "N27" [label="(9,2,0) Targeted compositions can enhance the strength and performance of printed components."];
  "N28" [label="(20,2,0) Understanding relationships helps achieve a crack-free, refined microstructure in AM."];

  "NROOT" [label="(0,0,0) This study proposes that T-even bacteriophages counter the DarTG1 toxin-antitoxin defense by using the NADAR-domain protein AdfN as an orphan antitoxin that enzymatically removes DarT1-added ADP-ribose from phage DNA, placing AdfN and related NADAR proteins within a broader enzymatic counter-defense strategy.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) A conserved phage resistance phenotype, a mapped anti-DarTG1 element, and NADAR-associated ADP-ribose removal jointly motivate a mechanistic model in which phage-encoded NADAR proteins enzymatically reverse DarT-mediated DNA modification."];

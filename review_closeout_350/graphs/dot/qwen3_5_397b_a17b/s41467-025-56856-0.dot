  "N1" [label="(1,1,0) PCR is widely used for selective amplification of target oligonucleotides."];
  "N10" [label="(4,0,0) Induction-Conclusion: The specificity of selecting oligonucleotides still largely depends on the length of the unique hybridization region."];
  "N13" [label="(0,0,0) Induction-Conclusion: Current oligo-selection methods face unique-region length constraints and primer-pair synthesis burden that increases with the number of subsets, so current methods face length-dependence and scalability bottlenecks."];
  "N14" [label="(16,1,0) Theoretically, four to the power of N oligo subsets can be encoded by N nucleotides."];
  "N15" [label="(17,1,0) Thousands of oligo subsets can be identified using only 6 nucleotides of the selection region."];
  "N16" [label="(0,0,0) Induction-Conclusion: 4^N encoding is possible and 6nt identifies thousands, so barcodes provide high capacity."];
  "N19" [label="(0,0,0) Induction-Conclusion: Method eliminates primers and reduces complexity, so barcode method reduces primer complexity."];
  "N1_2" [label="(0,0,0) Induction-Conclusion: PCR is widely used for selective amplification and facilitates selective amplification from complex libraries."];

  "N1" [label="(2,1,0) Currently, molecular forms of low nuclearity phosphorus species (P4, P2, P6) are highly unstable under ambient conditions."];
  "N10" [label="(10,2,0) Induction-case: Trans-linear chains containing [P8] cages have been predicted to be more stable than P4."];
  "N11" [label="(10,3,0) Induction-case: Helical chains containing [P8] cages have been predicted to be more stable than P4."];

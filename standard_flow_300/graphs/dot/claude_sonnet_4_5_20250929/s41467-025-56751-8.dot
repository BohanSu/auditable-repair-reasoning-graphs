digraph ReasoningTree {
  // paper_id=s41467-025-56751-8
  rankdir="TB";
  "I1" [label="(0,0,0) Deduction-rule: If proteins are important for industrial applications but require engineering to enhance properties, then there is a need for effective protein engineering methods Deduction-reasoning: Proteins are vital for industrial applications, and they require engineering to enhance properties, therefore there is a need for effective protein engineering methods"];
  "I4" [label="(0,0,0) Induction-case: Multiple studies show ML and BO successfully optimized various proteins (P450 thermostability, halogenase activity, GFP fluorescence) Induction-common: If ML/BO methods succeed across diverse protein optimization tasks, then ML represents a promising general approach Induction-reasoning: ML/BO succeeded in multiple protein optimization cases, therefore ML is a promising general approach for protein engineering"];
  "I8" [label="(0,0,0) Induction-case: Multiple biofoundry systems (PlasmidMaker, BioAutomata, genome editing platform) demonstrated automated high-throughput capabilities Induction-common: If biofoundries enable automated high-throughput operations across different applications, then they can provide the experimental infrastructure for data generation Induction-reasoning: Biofoundries succeeded in multiple automated applications, therefore they can provide experimental infrastructure for protein engineering"];
  "N1" [label="(1,0,0) Proteins play vital roles in medicine, chemical manufacturing, energy, agriculture, and consumer products"];
  "N10" [label="(11,0,0) Deduction-case: Software tools like Rosetta and HotSpot Wizard show promise but are effective only for relatively simple reactions, and de novo enzyme design remains in infancy"];
  "N11" [label="(12,0,0) Machine learning has emerged as a promising tool for exploring protein fitness landscapes"];
  "N12" [label="(13,0,0) ML-assisted directed evolution (MLDE) employs supervised ML models to predict fitness of protein variants with multiple mutations"];
  "N13" [label="(14,0,0) MLDE facilitates larger jumps in protein sequence space, helping bypass local optima in landscapes with strong epistasis"];
  "N14" [label="(15,0,0) Bayesian optimization is well-suited for identifying protein variants with substantially improved fitness"];
  "N15" [label="(16,0,0) Several studies have applied Gaussian process models with BO to optimize proteins"];
  "N16" [label="(17,0,0) Iterative BO demonstrated effectiveness in enhancing thermostability of P450 enzyme"];
  "N17" [label="(18,0,0) Similar BO methods applied to engineer halogenase activity, nitric oxide dioxygenase enantioselectivity, and GFP fluorescence wavelength"];
  "N18" [label="(19,0,0) Deduction-case: Widespread application of ML in protein engineering remains challenging in acquiring and modeling protein function data"];
  "N2" [label="(2,0,0) For industrial applications, proteins require engineering to enhance stability, activity, selectivity, and binding affinity"];
  "N23" [label="(24,0,0) Captured knowledge in PLMs could be applied to zero-shot optimization of specific proteins"];
  "N24" [label="(25,0,0) PLM-guided affinity maturation improved antibody binding affinities up to 160-fold by screening 20 or fewer variants"];
  "N27" [label="(28,0,0) Laboratory automation aided by biofoundries invaluable for generating large volumes of data needed for ML models"];
  "N28" [label="(29,0,0) Fully integrated biofoundry combines high-throughput instruments with peripheral devices coordinated by robotic arms and scheduling software"];
  "N29" [label="(31,0,0) PlasmidMaker developed for automated high-throughput plasmid design and construction"];
  "N30" [label="(32,0,0) BioAutomata: automated closed-loop system combining biofoundries and ML for engineering lycopene production pathway"];
  "N31" [label="(33,0,0) Automated high-throughput genome editing platform enabled editing thousands of samples within a week"];
  "N34" [label="(36,0,0) Deduction-case: SAMPLE only assembled pre-synthesized DNA fragments, exploring small protein landscape of 1352 sequences"];
  "N36" [label="(38,0,0) Deduction-case: BO algorithm could not guide mutant residue selection, and generality remains unknown"];
  "N5" [label="(5,0,0) Deduction-case: Traditional directed evolution is time-consuming and labor-intensive, though effective"];
  "N6" [label="(6,0,0) Deduction-case: Directed evolution typically introduces one mutation at a time and can be trapped in local fitness optima"];
  "N9" [label="(10,0,0) Deduction-case: Success of targeted mutagenesis is highly dependent on choice of target site, requiring deep understanding of protein structure-function relationship"];
  "NROOT" [label="(0,0,0) Develop and evaluate a self-driving protein-engineering strategy that combines PLM-guided mutant design with automated biofoundry Build-Test operations to test whether an integrated Design-Build-Test-Learn workflow can more rapidly discover and optimize high-fitness protein variants than traditional directed-evolution-centered approaches.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When established protein-engineering methods have practical limitations, ML/PLM approaches need validation and data support, and automated biofoundries can supply high-throughput Build-Test capacity, these conclusions jointly motivate developing and testing an integrated PLM-biofoundry protein-engineering workflow."];
  "R5" [label="(0,0,0) Traditional directed evolution has practical limitations because, although effective, it is time-consuming and labor-intensive and can become trapped in local fitness optima."];
  "R6" [label="(0,0,0) Targeted mutagenesis and computational enzyme-design tools are useful but limited by dependence on target-site knowledge and by restricted effectiveness for more complex reactions."];
  "R7" [label="(0,0,0) Because ML and Bayesian optimization are promising for protein engineering but widespread ML application remains challenged by acquiring and modeling protein-function data, those data and modeling challenges need to be addressed."];
  "R8" [label="(0,0,0) Protein language model knowledge has been applied to zero-shot or low-screening protein optimization, motivating PLMs as a way to reduce task-specific experimental data demands."];
  "R9" [label="(0,0,0) Existing autonomous or BO-guided protein-engineering platforms leave a gap because some explored small predefined libraries or could not guide mutant residue selection, and their generality remains uncertain."];
  "N1" -> "I1" [label="deduction-case"];
  "N2" -> "I1" [label="deduction-rule"];
  "N11" -> "I4" [label="induction-case"];
  "N12" -> "I4" [label="induction-case"];
  "N13" -> "I4" [label="induction-case"];
  "N14" -> "I4" [label="induction-case"];
  "N15" -> "I4" [label="induction-case"];
  "N16" -> "I4" [label="induction-case"];
  "N17" -> "I4" [label="induction-common"];
  "N27" -> "I8" [label="induction-case"];
  "N28" -> "I8" [label="induction-case"];
  "N29" -> "I8" [label="induction-case"];
  "N30" -> "I8" [label="induction-case"];
  "N31" -> "I8" [label="induction-common"];
  "N6" -> "R5" [label="deduction-rule"];
  "N5" -> "R5" [label="deduction-case"];
  "N10" -> "R6" [label="deduction-rule"];
  "N9" -> "R6" [label="deduction-case"];
  "N18" -> "R7" [label="deduction-rule"];
  "I4" -> "R7" [label="deduction-case"];
  "N24" -> "R8" [label="induction-case"];
  "N23" -> "R8" [label="induction-common"];
  "N36" -> "R9" [label="deduction-rule"];
  "N34" -> "R9" [label="deduction-case"];
  "I1" -> "NROOT" [label="induction-case"];
  "I8" -> "NROOT" [label="induction-case"];
  "R5" -> "NROOT" [label="induction-case"];
  "R6" -> "NROOT" [label="induction-case"];
  "R7" -> "NROOT" [label="induction-case"];
  "R8" -> "NROOT" [label="induction-case"];
  "R9" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

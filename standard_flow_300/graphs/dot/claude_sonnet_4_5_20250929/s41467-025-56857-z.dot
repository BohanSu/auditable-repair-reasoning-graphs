  "R2" [label="(0,0,0) Mouse Ncf1 m1J lupus phenotypes, human NCF1 90H SLE-risk evidence, and reduced ROS response in NCF1 90H cells jointly support low-ROS NCF1/Ncf1 variants as lupus or SLE susceptibility factors."];
  "R4" [label="(0,0,0) Because SLE causative genes and environmental factors remain difficult to identify, genetic crosses in inbred animal models provide a motivated approach for identifying underlying disease genes."];
  "R6" [label="(0,0,0) Infections are plausible environmental factors that may interact with genetic predisposition in autoimmune disease risk."];

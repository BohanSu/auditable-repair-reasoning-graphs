digraph ReasoningTree {
  // paper_id=s41467-025-56853-3
  rankdir="TB";
  "NROOT" [label="(0,0,0) Develop and evaluate an age-resolved, multi-model AD mouse proteome/phosphoproteome and protein-turnover resource, benchmarked against human data, to characterize shared AD molecular pathways, assess model suitability, and test how protein-turnover processes contribute to transcript-protein discrepancies and amyloid-plaque-associated protein changes.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When AD mouse models are imperfect, broad molecular readouts are needed, transcript-protein mismatches require proteomic and turnover-level analysis, and omics can be compared with human data, an integrated multi-model proteomic/phosphoproteomic benchmarking study is a coherent research strategy."];
  "R1" [label="(0,0,0) Because AD molecular mechanisms are not fully understood and suitable models are often lacking, generating and benchmarking more informative AD model-evaluation resources is required."];
  "R10" [label="(0,0,0) A comprehensive AD-mouse omics analysis is a plausible strategy for mapping shared AD pathways and altered turnover in amyloid plaques while supporting model benchmarking."];
  "R5" [label="(0,0,0) For researchers choosing among AD mouse models for specific hypotheses, an open comprehensive resource comparing model advantages and limitations would improve hypothesis-driven model selection."];
  "R6" [label="(0,0,0) Because omics technologies enable global evaluation of disease models and comparison with human data, they can be used to benchmark AD mouse models and map shared versus model-specific pathways."];
  "R8" [label="(0,0,0) The shallow depth, single-model focus, and weak human comparison of early AD-mouse proteomic studies motivate a deeper multi-model, age-resolved proteomic and phosphoproteomic study with human benchmarking."];
  "R9" [label="(0,0,0) When mRNA levels do not reliably match protein levels because of post-transcriptional processes such as translation and protein turnover, proteomics and turnover measurements are needed alongside transcriptomics for AD mechanism and model evaluation."];
  "n_c_complex_need_global" [label="(0,0,0) deduction-reasoning: Currently, AD has multiple pathologies/co-pathologies and many implicated genes, and if such complexity is unlikely to be captured by narrow readouts, so AD model evaluation should use broad/global molecular readouts."];
  "n_c_model_gap" [label="(0,0,0) deduction-reasoning: Currently, mechanisms are unclear due to lack of suitable models, and if that implies the need to build/benchmark better model resources, so there is a methodological gap in model suitability/benchmarking."];
  "n_c_models_imperfect" [label="(0,0,0) induction-reasoning: Given many familial-mutation mouse models exist and yet none captures full AD and neurodegeneration severity, in general current AD mouse models are imperfect and must be benchmarked for specific uses."];
  "n_c_need_proteomics" [label="(0,0,0) deduction-reasoning: Currently, transcript–protein inconsistency exists and mRNA may not predict protein due to translation/turnover, and if that implies proteomics/turnover are required, then AD model evaluation should include deep proteomics and turnover measurements."];
  "n_k_complexity" [label="(0,0,0) If a disease involves multiple pathologies and co-pathologies (not only Aβ/tau) and many risk genes, then single-mechanism or narrow readouts are unlikely to capture the full molecular spectrum."];
  "n_k_model_need" [label="(0,0,0) If molecular mechanisms are unclear due to lack of suitable models, then generating/benchmarking more informative model-evaluation resources is required."];
  "n_k_omics_fit" [label="(0,0,0) If omics technologies can globally quantify molecular states and be compared to human data, then omics can be used to benchmark mouse models and map shared versus model-specific pathways."];
  "n_k_prior_limits" [label="(0,0,0) If prior proteomic studies are limited in depth, model coverage, and human comparison, then a deeper multi-model, age-resolved proteomic + phosphoproteomic study with human benchmarking is needed."];
  "n_k_resource" [label="(0,0,0) If researchers need to choose among many imperfect mouse models, then an open, comprehensive, searchable resource comparing models and aligning them to human molecular patterns will improve hypothesis-driven model selection."];
  "n_k_rna_limits" [label="(0,0,0) If mRNA does not reliably predict protein abundance because of translation/turnover, then proteomics (and turnover measurements) are necessary alongside transcriptomics for mechanism and model evaluation."];
  "n_s11" [label="(11,0,0) Currently, mRNA levels do not always match protein levels because of post-transcriptional processes (translation, protein turnover)."];
  "n_s12" [label="(12,0,0) Currently, AD and 5xFAD show notable transcript–protein inconsistencies."];
  "n_s14" [label="(14,0,0) Currently, early AD-mouse proteomic studies were limited by shallow depth, focusing on single models, and/or weak comparison to human AD datasets."];
  "n_s18" [label="(18,0,0) Currently, the comprehensive proteomic analysis identifies shared AD pathways and altered turnover in amyloid plaques in AD mice."];
  "n_s3" [label="(3,0,0) Currently, AD also involves coexisting molecular changes beyond Aβ/tau (e.g., α-synuclein, TDP-43, U1 snRNP) that may affect progression."];
  "n_s5" [label="(5,0,0) Currently, the molecular mechanisms of these AD proteins/genes are not fully understood, often because suitable models are lacking."];
  "n_s6" [label="(6,0,0) Currently, >100 genetic AD mouse models exist, mainly familial-mutation-based (e.g., 5xFAD, 3xTG, APP-KI NLF/NLGF)."];
  "n_s7" [label="(7,0,0) Currently, existing AD mouse models do not capture the full spectrum of AD events and show less severe neurodegeneration than humans."];
  "n_s8" [label="(8,0,0) Currently, researchers need a comprehensive understanding of mouse-model advantages/limitations to choose models for specific hypotheses, but such a resource is unavailable."];
  "n_s9" [label="(9,0,0) Currently, omics advances enable global evaluation of disease models and assessment of relevance by comparing with human data."];
  "n_k_complexity" -> "n_c_complex_need_global" [label="deduction-rule"];
  "n_s3" -> "n_c_complex_need_global" [label="deduction-case"];
  "n_k_model_need" -> "n_c_model_gap" [label="deduction-rule"];
  "n_s5" -> "n_c_model_gap" [label="deduction-case"];
  "n_s6" -> "n_c_models_imperfect" [label="induction-case"];
  "n_s7" -> "n_c_models_imperfect" [label="induction-common"];
  "n_k_rna_limits" -> "n_c_need_proteomics" [label="deduction-rule"];
  "n_s12" -> "n_c_need_proteomics" [label="deduction-case"];
  "n_k_model_need" -> "R1" [label="deduction-rule"];
  "n_s5" -> "R1" [label="deduction-case"];
  "n_k_resource" -> "R5" [label="deduction-rule"];
  "n_s8" -> "R5" [label="deduction-case"];
  "n_k_omics_fit" -> "R6" [label="deduction-rule"];
  "n_s9" -> "R6" [label="deduction-case"];
  "n_k_prior_limits" -> "R8" [label="deduction-rule"];
  "n_s14" -> "R8" [label="deduction-case"];
  "n_k_rna_limits" -> "R9" [label="deduction-rule"];
  "n_s11" -> "R9" [label="deduction-case"];
  "n_s18" -> "R10" [label="abduction-phenomenon"];
  "R6" -> "R10" [label="abduction-knowledge"];
  "R1" -> "NROOT" [label="induction-case"];
  "R10" -> "NROOT" [label="induction-case"];
  "R5" -> "NROOT" [label="induction-case"];
  "R8" -> "NROOT" [label="induction-case"];
  "R9" -> "NROOT" [label="induction-case"];
  "n_c_complex_need_global" -> "NROOT" [label="induction-case"];
  "n_c_model_gap" -> "NROOT" [label="induction-case"];
  "n_c_models_imperfect" -> "NROOT" [label="induction-case"];
  "n_c_need_proteomics" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

  "K1" -> "R4" [label="deduction-rule"];
  "N1v" -> "R4" [label="deduction-case"];
  "K2" -> "R5" [label="deduction-rule"];
  "N3" -> "R5" [label="deduction-case"];
  "R5" -> "R6" [label="deduction-rule"];
  "K3" -> "R6" [label="deduction-case"];
  "C3" -> "NROOT" [label="induction-case"];
  "C6" -> "NROOT" [label="induction-case"];
  "R4" -> "NROOT" [label="induction-case"];

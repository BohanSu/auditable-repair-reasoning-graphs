digraph ReasoningTree {
  // paper_id=s41467-025-56857-z
  rankdir="TB";
  "I10" [label="(0,0,0) If infection effects on autoimmunity are context- and genotype-dependent, then controlled infection exposures should be used in G×E experiments to test causality."];
  "I3" [label="(0,0,0) If a genetic variant is associated with SLE risk and produces a measurable immune phenotype (e.g., low ROS and high IFN signaling), then it is a plausible causal driver whose mechanism can be modeled in animals."];
  "I7" [label="(0,0,0) If a specific infection can act as a non-autologous trigger, then a susceptible genotype plus that infection can jointly cause autoimmune disease (a genotype×infection synergy model)."];
  "I9" [label="(0,0,0) induction: Given that COVID-19 can exacerbate autoimmunity in predisposed individuals and there is no broad evidence it triggered lupus generally, therefore infections can be relevant but require genotype/context-specific testing rather than assuming a single universal trigger."];
  "N1" [label="(1,0,0) Currently, SLE is caused by an interplay of many (partly unknown) genes and environmental factors."];
  "N12" [label="(12,0,0) Currently, in SLE patients the NCF1 90H allele causes decreased ROS and is associated with activated interferon signaling (similar to Ncf1 m1J mice)."];
  "N13" [label="(13,0,0) Currently, BALB/c Ncf1 m1J mice show spontaneous lupus signs and develop severe pristane-induced lupus (a common SLE model)."];
  "N14" [label="(14,0,0) Currently, Ncf1 m1J mutation is associated with activation of interferon signaling genes including STAT1."];
  "N18" [label="(18,0,0) Currently, there is no substantial evidence that the SARS-CoV-2 epidemic broadly triggered lupus (only scattered reports)."];
  "N19" [label="(19,0,0) Currently, COVID-19 can trigger presentation/exacerbation of autoimmune diseases and chronic inflammation in genetically predisposed patients."];
  "N20" [label="(20,0,0) Currently, genetic predisposition contributes substantially to autoimmune risk and interacting environmental factors can include infections."];
  "N21" [label="(21,0,0) Currently, NCF1-regulated interferon differences in germ-free mice appear only after immune challenge (immunization/pristane), and pristane triggers more severe lupus-associated responses."];
  "N26" [label="(26,0,0) Currently, MNV infection causes severe lupus in Ncf1 90H mice regardless of pristane/naïve status."];
  "N27" [label="(27,0,0) Currently, there is described synergy between a defined gene mutation and a specific non-autologous factor to induce autoimmune disease."];
  "N3" [label="(3,0,0) Currently, GWAS have identified many SLE-associated loci, supporting that SLE is polygenic and regulated by immune tolerance/responsiveness loci."];
  "N6" [label="(6,0,0) Currently, positioning causative genes in mice/rats has identified important SNPs for complex autoimmune diseases."];
  "N8" [label="(8,0,0) Currently, Ncf1 amino-acid-changing SNP effects in rats were reproduced in mice with an Ncf1 m1J mutation."];
  "NROOT" [label="(0,0,0) Develop and evaluate a controlled Ncf1 R90H mouse gene-by-environment model to test whether murine norovirus infection, rather than pristane exposure under pathogen-free conditions alone, synergizes with the low-ROS NCF1 risk variant to drive severe lupus-like autoimmunity and interferon-related mechanisms.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When SLE risk variants and environmental triggers are difficult to resolve from association studies, controlled animal gene-by-environment experiments can test whether a specific genotype and exposure jointly cause lupus-like disease."];
  "R10" [label="(0,0,0) The association of low-ROS NCF1/Ncf1 variants with interferon activation, together with lupus phenotypes in Ncf1 m1J mice, makes the mechanism linking low ROS, interferon responses, and lupus an important open question."];
  "R12" [label="(0,0,0) Because NCF1-regulated interferon differences appear after immune challenge and infections can be interacting environmental factors in genetically predisposed autoimmunity, infection is a plausible trigger to test in low-ROS NCF1 contexts."];
  "R13" [label="(0,0,0) Because infection effects on autoimmunity can be genotype- and context-dependent, controlled infection exposures are appropriate for testing causality in gene-by-environment SLE-like models."];
  "R14" [label="(0,0,0) The human-relevant low-ROS NCF1 90H variant provides a justified candidate for animal modeling of NCF1 pathogenic mechanisms."];
  "R2" [label="(0,0,0) Low-ROS NCF1/Ncf1 variants are repeatedly associated with interferon-pathway activation in human SLE and mouse contexts, motivating investigation of how reduced ROS relates to interferon signaling and autoimmunity."];
  "R4" [label="(0,0,0) Because NCF1 90H is associated with decreased ROS and activated interferon signaling in SLE-relevant contexts, it is a plausible human-relevant variant for mechanistic modeling in animals."];
  "R6" [label="(0,0,0) Mouse and rat models are useful for studying amino-acid-changing Ncf1 SNP effects relevant to complex autoimmune disease."];
  "R7" [label="(0,0,0) Because SLE is polygenic and environmentally influenced, and GWAS have identified many associated loci, association evidence alone motivates follow-up functional testing to evaluate candidate causal genes and environmental triggers."];
  "I7" -> "N27" [label="deduction-rule"];
  "N26" -> "N27" [label="deduction-case"];
  "N19" -> "I9" [label="induction-case"];
  "N18" -> "I9" [label="induction-common"];
  "N1" -> "R7" [label="induction-case"];
  "N3" -> "R7" [label="induction-common"];
  "N12" -> "R2" [label="induction-case"];
  "N14" -> "R2" [label="induction-common"];
  "R2" -> "R10" [label="deduction-rule"];
  "N13" -> "R10" [label="deduction-case"];
  "N21" -> "R12" [label="abduction-phenomenon"];
  "N20" -> "R12" [label="abduction-knowledge"];
  "I3" -> "R4" [label="deduction-rule"];
  "N12" -> "R4" [label="deduction-case"];
  "N8" -> "R6" [label="induction-case"];
  "N6" -> "R6" [label="induction-common"];
  "I10" -> "R13" [label="deduction-rule"];
  "I9" -> "R13" [label="deduction-case"];
  "I3" -> "R14" [label="deduction-rule"];
  "N12" -> "R14" [label="deduction-case"];
  "N27" -> "NROOT" [label="induction-case"];
  "R10" -> "NROOT" [label="induction-case"];
  "R12" -> "NROOT" [label="induction-case"];
  "R13" -> "NROOT" [label="induction-case"];
  "R14" -> "NROOT" [label="induction-case"];
  "R4" -> "NROOT" [label="induction-case"];
  "R6" -> "NROOT" [label="induction-case"];
  "R7" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

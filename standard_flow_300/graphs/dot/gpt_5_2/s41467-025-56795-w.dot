  "R1" -> "R11" [label="induction-common"];
  "N20" -> "R4" [label="abduction-phenomenon"];
  "R1" -> "R4" [label="abduction-knowledge"];
  "N15" -> "NROOT" [label="induction-case"];
  "R11" -> "NROOT" [label="induction-case"];
  "R4" -> "NROOT" [label="induction-case"];

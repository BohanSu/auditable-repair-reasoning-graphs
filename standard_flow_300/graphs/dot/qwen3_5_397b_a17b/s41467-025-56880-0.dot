  "N1" [label="(0,0,0) Abduction-reasoning: Observed plasticity and known force reliance, suggesting cytoskeleton remodeling under signaling."];
  "N14" [label="(0,0,0) Deduction-reasoning: Role is elusive and aim exists, so investigate."];

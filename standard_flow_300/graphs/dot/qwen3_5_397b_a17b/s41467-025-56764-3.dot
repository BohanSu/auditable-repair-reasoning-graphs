digraph ReasoningTree {
  // paper_id=s41467-025-56764-3
  rankdir="TB";
  "NROOT" [label="(0,0,0) The paper aims to investigate and evaluate whether media-shaped positive and negative beliefs about solitude causally modulate how being alone affects loneliness, identifying such beliefs as a potentially modifiable driver of loneliness across diverse populations.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) Across public discourse, theory about belief effects, real-life evidence, and cross-population generalizability, beliefs about solitude are treated as a plausible modifiable mechanism affecting loneliness."];
  "N_I1" [label="(0,0,0) Induction: Loneliness is linked to negative outcomes, and if it is an epidemic and linked to death, then it is a major health concern."];
  "N_I3" [label="(0,0,0) Induction: Warnings proliferate and campaigns emphasize danger, so discourse portrays loneliness as harmful."];
  "N_I5" [label="(0,0,0) Induction: Being alone does not equal loneliness."];
  "N_I5_A" [label="(0,0,0) Induction: Being alone and loneliness are distinct states and some are content alone."];
  "N_I5_B" [label="(0,0,0) Induction: Some feel lonely despite interaction and correlation is weak."];
  "N_I6_A" [label="(0,0,0) Induction: Modest associations exist and loneliness is negative."];
  "N_I7_B" [label="(0,0,0) Induction: Being alone can induce loneliness but also promote well-being."];
  "N_I8" [label="(0,0,0) Induction: Beliefs powerfully impact responses."];
  "N_I8_A" [label="(0,0,0) Induction: Thoughts influence impact and beliefs powerfully impact responses."];
  "N_I8_B" [label="(0,0,0) Induction: Beliefs recruit brain networks and effects are well documented."];
  "N_I_DailyEffect" [label="(0,0,0) Induction: Media shapes beliefs and negative beliefs increase loneliness, so beliefs influence loneliness in daily life."];
  "N_I_Gap" [label="(0,0,0) Abduction: Lab evidence exists and extension is unclear, so real-life evidence is needed."];
  "N_I_Gap_A" [label="(0,0,0) Abduction: Lab evidence shows benefits and extends to 10 mins."];
  "N_I_Paradox" [label="(0,0,0) Abduction: Discourse portrays alone as harmful and reality shows alone is not harmful, so discourse may contribute to problem."];
  "N_I_Reality_4" [label="(0,0,0) Induction: Spending time alone promotes emotion regulation and cognitive restoration."];
  "N_I_Theory" [label="(0,0,0) Induction: Beliefs impact responses and effects are wide-ranging, so beliefs about being alone should influence experience."];
  "N_S10_V1" [label="(10,1,0) Fact: Study of 11,000 participants showed weak relationship (r=0.20) between being alone and loneliness."];
  "N_S11_V1" [label="(11,1,0) Fact: Recent studies show modest associations (r=0.13 to 0.25) between being alone and loneliness."];
  "N_S12_V1" [label="(12,1,0) Fact: Loneliness is a negative state people try to avoid."];
  "N_S12_V2" [label="(12,2,0) Fact: Time alone can be a desirable part of daily life."];
  "N_S13_V1" [label="(13,1,0) Fact: American adults spend 30-65% of waking hours alone."];
  "N_S13_V2" [label="(13,2,0) Fact: American adults often intentionally seek out experiences of being alone."];
  "N_S14_V1" [label="(14,1,0) Fact: 85% of time spent alone is deliberately chosen."];
  "N_S15_V1" [label="(15,1,0) Fact: Being alone can induce loneliness."];
  "N_S16_V1" [label="(16,1,0) Fact: Spending time alone can promote well-being."];
  "N_S16_V2" [label="(16,2,0) Fact: Spending time alone can promote emotion regulation."];
  "N_S16_V3" [label="(16,3,0) Fact: Spending time alone can promote cognitive restoration."];
  "N_S17_V1" [label="(17,1,0) Fact: Spending less time alone than desired is associated with increased stress."];
  "N_S17_V2" [label="(17,2,0) Fact: Spending less time alone than desired is associated with increased depression."];
  "N_S19_V1" [label="(19,1,0) Fact: How people think about being alone may influence its emotional impact."];
  "N_S1_V1" [label="(1,1,0) Fact: Loneliness is often described as a global epidemic."];
  "N_S1_V2" [label="(1,2,0) Fact: Loneliness is linked to negative outcomes like depression and death."];
  "N_S20_V1" [label="(20,1,0) Fact: People's beliefs powerfully impact emotional responses to situations."];
  "N_S20_V2" [label="(20,2,0) Fact: Beliefs impact emotions by recruiting prefrontal and parietal networks."];
  "N_S21_V1" [label="(21,1,0) Fact: The wide-ranging nature of belief effects on emotion is well documented."];
  "N_S22_V1" [label="(22,1,0) Fact: Interventions targeting beliefs impact stress experiences."];
  "N_S22_V2" [label="(22,2,0) Fact: Interventions targeting beliefs impact depression experiences."];
  "N_S22_V3" [label="(22,3,0) Fact: Interventions targeting beliefs impact weight loss and sleep."];
  "N_S23_V1" [label="(23,1,0) Fact: People's beliefs about being alone should influence experiences of time alone."];
  "N_S24_V1" [label="(24,1,0) Fact: Preliminary evidence from lab experiments shows teaching benefits of alone time increases positivity."];
  "N_S24_V2" [label="(24,2,0) Fact: Preliminary evidence from lab experiments shows teaching benefits of alone time increases positivity after 10 mins."];
  "N_S25_V1" [label="(25,1,0) Fact: It is unclear whether lab findings extend beyond a brief laboratory task."];
  "N_S26_V1" [label="(26,1,0) Fact: Five multi-method studies provide evidence that beliefs about being alone influence loneliness."];
  "N_S26_V2" [label="(26,2,0) Fact: People's beliefs about being alone are shaped by media discourse."];
  "N_S27_V1" [label="(27,1,0) Fact: Study 1 finds U.S. news articles frequently portray being alone as harmful."];
  "N_S29_V1" [label="(29,1,0) Fact: Study 3 shows negative beliefs increase loneliness after time alone in daily life."];
  "N_S29_V2" [label="(29,2,0) Fact: Study 3 shows positive beliefs decrease loneliness after time alone in daily life."];
  "N_S2_V1" [label="(2,1,0) Fact: WHO declared loneliness a major health concern in 2019."];
  "N_S2_V2" [label="(2,2,0) Fact: U.S. released a Surgeon General's Advisory on loneliness in 2023."];
  "N_S30_V1" [label="(30,1,0) Fact: Studies 4 and 5 demonstrate generalizability across nine countries and six continents."];
  "N_S3_V1" [label="(3,1,0) Fact: Media articles have proliferated with warnings about the dangers of being alone."];
  "N_S3_V2" [label="(3,2,0) Fact: Public health campaigns have proliferated with warnings about the dangers of being alone."];
  "N_S4_V1" [label="(4,1,0) Fact: Commit to Connect campaign prioritizes increasing awareness about harms of isolation."];
  "N_S5_V1" [label="(5,1,0) Fact: UK Campaign reports isolation is as harmful as smoking 15 cigarettes a day."];
  "N_S5_V2" [label="(5,2,0) Fact: UK Campaign reports isolation is more damaging than obesity."];
  "N_S7_V1" [label="(7,1,0) Fact: Being alone is not inherently harmful."];
  "N_S8_V2" [label="(8,2,0) Fact: Being alone and loneliness are distinct states."];
  "N_S9_V1" [label="(9,1,0) Fact: Some people are content spending time alone."];
  "N_S9_V2" [label="(9,2,0) Fact: Some people interact frequently and still feel lonely."];
  "R14" [label="(0,0,0) Induction: Time alone can be desirable, and American adults spend a substantial share of waking hours alone."];
  "R15" [label="(0,0,0) Induction: Among American adults, time alone is common and often deliberately chosen."];
  "R16" [label="(0,0,0) Induction: American adults often seek alone time, and most time spent alone is deliberately chosen."];
  "R18" [label="(0,0,0) Induction: Alone time is often chosen and can be associated with either loneliness or well-being, suggesting varied experiences of being alone."];
  "R19" [label="(0,0,0) Induction: Being alone and loneliness are distinct, so treating being alone as equivalent to loneliness is incorrect."];
  "R2" [label="(0,0,0) Induction: WHO and U.S. public-health authorities have both formally recognized loneliness as a major health concern."];
  "R23" [label="(0,0,0) Induction: Spending less time alone than desired is associated with increased stress and depression."];
  "R3" [label="(0,0,0) Induction: Both media articles and public-health campaigns warn about the dangers of being alone."];
  "R30" [label="(0,0,0) Induction: Belief-targeting interventions have been reported to affect stress and depression experiences."];
  "R31" [label="(0,0,0) Induction: Evidence that belief-targeting interventions affect weight-loss and sleep experiences supports the expectation that beliefs about being alone may influence experiences of time alone."];
  "R32" [label="(0,0,0) Induction: Belief-related effects across stress, depression, weight loss, sleep, and time-alone expectations suggest that beliefs can shape experiences across multiple domains."];
  "R35" [label="(0,0,0) Abduction: If public discourse portrays being alone as harmful while being alone is not inherently harmful, and beliefs about being alone should influence experience, then discourse-shaped beliefs may help explain loneliness after solitude."];
  "R38" [label="(0,0,0) Deduction: A hypothesis that beliefs about being alone may shape loneliness, combined with uncertainty about whether brief lab findings extend to real life, warrants real-life evaluation of belief-loneliness links."];
  "R39" [label="(0,0,0) Deduction: Five multi-method studies providing evidence that beliefs about being alone influence loneliness address the need for real-life evaluation of belief-loneliness links."];
  "R4" [label="(0,0,0) Induction: Specific public-health campaigns and reports emphasize harms of isolation, including awareness of harms and comparison to smoking."];
  "R40" [label="(0,0,0) Deduction: If media discourse shapes beliefs about being alone and U.S. news articles frequently portray being alone as harmful, then harmful news portrayals are a plausible media route for shaping beliefs about being alone."];
  "R42" [label="(0,0,0) Induction: In Study 3, negative beliefs predict greater loneliness after time alone in daily life, whereas positive beliefs predict less loneliness after time alone."];
  "R44" [label="(0,0,0) Induction: Evidence that beliefs influence loneliness in daily life, together with generalizability across nine countries and six continents, suggests that belief-loneliness links extend across diverse populations."];
  "R45" [label="(0,0,0) Induction: The multi-method studies provide empirical support that beliefs about being alone are linked to loneliness in daily life and across diverse populations."];
  "R46" [label="(0,0,0) Induction: The hypothesis and multi-method evidence support beliefs about being alone as a plausible, modifiable contributor to loneliness rather than a deductively proven driver."];
  "R6" [label="(0,0,0) Induction: Loneliness is framed as a major public-health concern by negative-outcome evidence and institutional recognition."];
  "R7" [label="(0,0,0) Induction: Public discourse portrays loneliness or isolation as harmful, including comparisons between isolation and obesity."];
  "R9" [label="(0,0,0) Induction: Because being alone is not inherently harmful and is distinct from loneliness, conflating being alone with loneliness is incorrect."];

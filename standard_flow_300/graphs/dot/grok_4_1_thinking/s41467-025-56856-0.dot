  "N27" -> "R11" [label="deduction-rule"];
  "N26" -> "R11" [label="deduction-case"];
  "N31" -> "R13" [label="abduction-phenomenon"];
  "R11" -> "R13" [label="abduction-knowledge"];
  "N17" -> "NROOT" [label="induction-case"];
  "N19" -> "NROOT" [label="induction-case"];
  "N23" -> "NROOT" [label="induction-case"];
  "R10" -> "NROOT" [label="induction-case"];
  "R13" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];

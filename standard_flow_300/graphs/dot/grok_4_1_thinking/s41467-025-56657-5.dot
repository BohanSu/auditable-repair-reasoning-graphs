digraph ReasoningTree {
  rankdir="TB";
  "B_case" [label="(3,0,0) Specific observed case: In immunocompromised and critically ill patients, C. albicans transitions from a commensal organism in the gut to an opportunistic pathogen causing disseminated candidiasis."];
  "B_common" [label="(4,0,0) Common pattern: In developed countries, this leads to a mortality rate that can exceed 40%, even with antifungal treatment."];
  "B_concl" [label="(0,0,0) Conclusion: inductive reasoning: Given the specific case and common pattern, therefore the generalization is that C. albicans causes high-mortality disseminated infections."];
  "C_case" [label="(5,0,0) Specific observed case: Hyphal morphogenesis controls the balance between gut commensalism and invasive infection."];
  "C_common" [label="(6,0,0) Common pattern: C. albicans invades host tissues through a process associated with yeast-to-hyphal transition."];
  "C_concl" [label="(0,0,0) Conclusion: inductive reasoning: Given the specific case and common pattern, therefore the generalization is that yeast-to-hyphal transition is central to invasion and pathogenesis."];
  "D_case" [label="(7,0,0) Specific observed case: Hyphae induce a higher level of IL-1β secretion than the yeast form."];
  "D_common" [label="(9,0,0) Common pattern: C. albicans candidalysin (hypha-secreted pore-forming toxin) damages epithelial cells and fuels proinflammatory immunity in the mucosa and gut; Als proteins (including hypha-specific Als3) exacerbate intestinal colitis and colon damage (covering viewpoints from sentences 8,10,11,12)."];
  "E_case" [label="(13,0,0) Specific observed case: Death effector domains (DEDs) are protein-protein interaction domains identified in FADD, caspase-8, and cFLIP that regulate inflammation and cell death (apoptosis, pyroptosis, necroptosis)."];
  "E_common" [label="(14,0,0) Common pattern: FADD initiates caspase-8 oligomerization via DED-DED interactions, forming a FADD/caspase-8 complex that regulates cell death pathways."];
  "E_concl" [label="(0,0,0) Conclusion: inductive reasoning: Given the specific case and common pattern, therefore the generalization is that DEDs in FADD and caspase-8 regulate cell death pathways."];
  "F_case" [label="(15,0,0) Specific observed case: Genetic ablation of either Caspase-8 or Fadd in intestinal epithelial cells (IECs) results in necroptosis and caspase-8-gasdermin-D-mediated pyroptosis-like death, leading to spontaneous ileitis and/or colitis."];
  "F_common" [label="(16,0,0) Common pattern: Expression of catalytically inactive caspase-8 triggers the formation of caspase-8/ASC specks, activation of caspase-1, and secretion of IL-1β."];
  "F_concl" [label="(0,0,0) Conclusion: inductive reasoning: Given the specific case and common pattern, therefore the generalization is that dysfunction of caspase-8/FADD leads to excessive cell death and intestinal inflammation."];
  "G_common" [label="(19,0,0) Common pattern: The cellular FLICE-like inhibitory protein (cFLIPs) and viral FLIPs (vFLIPs) function as apoptosis inhibitors and consist of two tandem DEDs similar to the prodomain of caspase-8."];
  "H_case" [label="(20,0,0) Specific observed case: vFLIPs inhibit death ligand-induced apoptosis by interacting with FADD and/or caspase-8 via DED-DED interaction."];
  "H_common" [label="(22,0,0) Common pattern: As an extracellular organism, C. albicans proteins have not been reported to directly influence intracellular cell death core components at the molecular level (covering C. albicans DNA in extracellular vesicles triggering cGAS-STING from sentence 21 and intracellular pathogen context from sentence 18)."];
  "H_concl" [label="(0,0,0) Conclusion: inductive reasoning: Given the specific case and common pattern, therefore the generalization is that there is a gap in knowledge for C. albicans protein intracellular modulation of cell death, despite vFLIP mechanisms."];
  "NROOT" [label="(0,0,0) Test whether the hypha-specific Candida albicans adhesin Als3, despite lacking a death-effector domain, directly binds the DEDs of host FADD and caspase-8 in a viral-FLIP-like manner to modulate inflammatory signaling and cell-death pathways during fungal infection.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) The retained and repaired terminal conclusions jointly motivate the paper-level research proposal."];
  "R10" [label="(0,0,0) FLIP proteins, including viral FLIPs, can inhibit apoptosis through DED-mediated interactions involving FADD and/or caspase-8."];
  "R12" [label="(0,0,0) FADD and caspase-8 DED-dependent signaling regulates cell-death pathways, and disruption of this axis can lead to excessive epithelial cell death and intestinal inflammation."];
  "R13" [label="(0,0,0) Known viral FLIP mechanisms use DED-mediated interactions with FADD and/or caspase-8, while direct molecular modulation of intracellular cell-death components by C. albicans proteins remains a knowledge gap."];
  "R14" [label="(0,0,0) Because FADD/caspase-8 DED signaling controls cell-death and inflammatory outcomes, and because viral FLIPs provide a DED-based precedent while fungal protein mechanisms remain unclear, fungal engagement of host DED machinery is a plausible mechanistic research focus."];
  "R4" [label="(0,0,0) Hyphal C. albicans is linked to higher IL-1β secretion than yeast-form cells, and the hypha-secreted toxin candidalysin damages epithelial cells and fuels proinflammatory immunity in mucosal and gut contexts."];
  "R6" [label="(0,0,0) The yeast-to-hyphal transition and hyphal-associated factors are linked to C. albicans invasion, pathogenesis, IL-1β-associated inflammation, epithelial damage, and proinflammatory mucosal responses."];
  "B_case" -> "B_concl" [label="induction-case"];
  "B_common" -> "B_concl" [label="induction-common"];
  "C_case" -> "C_concl" [label="induction-case"];
  "C_common" -> "C_concl" [label="induction-common"];
  "E_case" -> "E_concl" [label="induction-case"];
  "E_common" -> "E_concl" [label="induction-common"];
  "F_case" -> "F_concl" [label="induction-case"];
  "F_common" -> "F_concl" [label="induction-common"];
  "H_case" -> "H_concl" [label="induction-case"];
  "H_common" -> "H_concl" [label="induction-common"];
  "D_case" -> "R4" [label="induction-case"];
  "D_common" -> "R4" [label="induction-common"];
  "C_concl" -> "R6" [label="induction-case"];
  "R4" -> "R6" [label="induction-common"];
  "H_case" -> "R10" [label="induction-case"];
  "G_common" -> "R10" [label="induction-common"];
  "E_concl" -> "R12" [label="induction-case"];
  "F_concl" -> "R12" [label="induction-common"];
  "R10" -> "R13" [label="induction-case"];
  "H_concl" -> "R13" [label="induction-common"];
  "R12" -> "R14" [label="abduction-phenomenon"];
  "R13" -> "R14" [label="abduction-knowledge"];
  "B_concl" -> "NROOT" [label="induction-case"];
  "R14" -> "NROOT" [label="induction-case"];
  "R6" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

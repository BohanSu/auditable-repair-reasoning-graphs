digraph ReasoningTree {
  rankdir="TB";
  "N1" [label="(1,0,0) Specific case: Huntington’s disease (HD) is a genetic, progressive neurodegenerative disease, which manifests with characteristic motor, cognitive, and psychiatric symptoms that arise generally at midlife and progress during 10 to 15 years, with subtle signs that can appear decades earlier."];
  "N10" [label="(10,0,0) Specific case: Here, we investigated HD striatal epigenetic landscape using fluorescence-activated nuclei sorting (FANS) coupled to ChIPseq or CUT&Tag."];
  "N11" [label="(11,0,0) Common pattern: We profiled neuronal and non-neuronal striatal cells in two reference HD mouse models, R6/1 transgenic and Q140 knockin (KI) mice, showing distinct disease progressions."];
  "N12" [label="(12,0,0) Common pattern: Additionally, we performed temporal analysis at 3 ages, corresponding to prodromal, early and advanced pathological stages in HD Q140 mice."];
  "N18" [label="(0,0,0) Deductive reasoning: Given deduction-case epigenetic alteration as hallmark of cellular aging (N5) and deduction-rule cellular aging caused by exdifferentiation from epigenetic erosion (N6), therefore cellular aging is driven by loss of epigenetic information leading to cellular identity loss."];
  "N2" [label="(2,0,0) Common pattern: The disease is caused by an abnormal expansion of CAG trinucleotide repeats in the Huntingtin (HTT) gene, which produces mutant HTT with polyglutamine expansion (polyQ)."];
  "N21" [label="(0,0,0) Inductive reasoning: From specific case of striatal spiny neuron vulnerability (N3) and common pattern of elusive molecular underpinning (N4), therefore we generalize that striatal spiny projection neurons are highly vulnerable in HD with elusive molecular underpinning."];
  "N23" [label="(0,0,0) Inductive reasoning: From specific case of FANS-coupled ChIPseq/CUT&Tag investigation (N10) and common pattern of profiling neuronal and non-neuronal striatal cells in two HD mouse models (N11), therefore we generalize that the study employs cell-type-specific epigenetic analysis in relevant HD models."];
  "N24" [label="(0,0,0) Inductive reasoning: From specific case of HD symptoms/progression (N1) and common pattern of genetic cause (N2), therefore we generalize that HD is a genetic, progressive neurodegenerative disease with known etiology."];
  "N26" [label="(0,0,0) Inductive reasoning: From specific case of cell-type-specific FANS study (N23) and common pattern of temporal analysis at 3 ages in HD Q140 mice (N12), therefore we generalize that the study design provides required cellular and temporal resolution to test the accelerated epigenetic aging hypothesis."];
  "N3" [label="(3,0,0) Specific case: Specific neurons, particularly direct and indirect spiny projection neurons (dSPN and iSPN, respectively) in the striatum, representing >95% of striatal neurons, are highly vulnerable to the HD mutation."];
  "N4" [label="(4,0,0) Common pattern: Molecular underpinning of striatal neuron vulnerability in HD remains elusive."];
  "N5" [label="(5,0,0) Currently there is: Epigenetic alteration is a key hallmark of cellular aging."];
  "N6" [label="(6,0,0) Deduction-rule: If cellular aging is caused by loss of cellular identity resulting from erosion of epigenetic information, so-called exdifferentiation, then cellular aging is driven by epigenetic information erosion leading to identity loss."];
  "N7" [label="(7,0,0) Deduction-rule: If histone modifications, including the active mark H3K27 acetylation (H3K27ac) and the repressive mark H3K27 trimethylation (H3K27me3), are used as proxy to assess exdifferentiation, which is characterized by de-repression of non-lineage-specific genes (particularly developmental genes) and repression of cellular identity genes, then changes in these marks at striatal super-enhancers indicate exdifferentiation and accelerated epigenetic aging."];
  "N8" [label="(8,0,0) Currently there is: Epigenomic analyses in bulk HD striatal tissue show early loss of H3K27ac at striatal super-enhancers (broad enhancers regulating cellular identity genes), which results in transcriptional downregulation of their targets, striatal identity genes."];
  "N9" [label="(9,0,0) Common pattern: Due to lack of cellular and temporal resolutions of earlier analyses, it was unclear whether HD vulnerable neurons undergo accelerated epigenetic aging, including accelerated de-repression of developmental genes."];
  "NROOT" [label="(0,0,0) Research proposal: test whether mutant huntingtin in Huntington’s disease accelerates epigenetic aging in vulnerable striatal projection neurons by disrupting H3K27-linked chromatin regulation, including PRC1-mediated CBX paralog switching, de-repression of developmental genes, and repression or erosion of striatal identity gene programs that may contribute to selective neuronal vulnerability.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) Common bridge pattern: cell-type- and time-resolved chromatin profiling can connect mutant huntingtin-driven HD pathology to neuronal vulnerability by measuring aging-linked epigenetic erosion, H3K27-associated marks, PRC1-related regulation, developmental-gene de-repression, and striatal identity-gene loss in the affected striatal projection neurons."];
  "R2" [label="(0,0,0) HD is a mutant-HTT-driven progressive neurodegenerative disease in which striatal spiny projection neurons are highly vulnerable, while the molecular basis of that selective vulnerability remains unresolved."];
  "R5" [label="(0,0,0) Early H3K27ac loss at striatal super-enhancers in bulk HD striatal tissue provides evidence for downregulation of striatal cellular-identity genes, matching the identity-gene repression component of epigenetic erosion/exdifferentiation assays."];
  "R6" [label="(0,0,0) Before cell-type- and time-resolved analyses, it remained unclear whether HD-vulnerable striatal projection neurons undergo accelerated epigenetic aging, including accelerated de-repression of developmental genes."];
  "R7" [label="(0,0,0) Because striatal projection-neuron vulnerability in HD remained molecularly unresolved and epigenetic aging in those vulnerable neurons was unclear, the epigenetic-erosion framework motivates testing whether HD-vulnerable striatal neurons undergo accelerated epigenetic aging."];
  "N1" -> "N24" [label="induction-case"];
  "N2" -> "N24" [label="induction-common"];
  "N3" -> "N21" [label="induction-case"];
  "N4" -> "N21" [label="induction-common"];
  "N5" -> "N18" [label="deduction-case"];
  "N6" -> "N18" [label="deduction-rule"];
  "N10" -> "N23" [label="induction-case"];
  "N11" -> "N23" [label="induction-common"];
  "N23" -> "N26" [label="induction-case"];
  "N12" -> "N26" [label="induction-common"];
  "N21" -> "R2" [label="induction-case"];
  "N24" -> "R2" [label="induction-common"];
  "N7" -> "R5" [label="deduction-rule"];
  "N8" -> "R5" [label="deduction-case"];
  "N21" -> "R6" [label="induction-case"];
  "N9" -> "R6" [label="induction-common"];
  "R6" -> "R7" [label="abduction-phenomenon"];
  "N18" -> "R7" [label="abduction-knowledge"];
  "N26" -> "NROOT" [label="induction-case"];
  "R2" -> "NROOT" [label="induction-case"];
  "R5" -> "NROOT" [label="induction-case"];
  "R7" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

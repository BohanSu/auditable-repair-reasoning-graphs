digraph ReasoningTree {
  // paper_id=s41467-025-56295-x
  rankdir="TB";
  "NROOT" [label="(0,0,0) The paper aims to develop and evaluate highly porous Zn-based ZIF precursors, including bulky amide-solvent structure-directing strategies and imidazole/benzimidazole ligand design, to form porosity-preserving MOF glasses and membranes that resist densification during melting and improve gas adsorption and CO₂/CH₄/N₂ separation performance.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) The retained and repaired conclusions jointly motivate a materials-design program: use porous MOF/ZIF chemistry to meet climate-driven gas-separation needs, overcome crystalline-MOF processing limits through MOF glasses and membranes, and preserve or enhance porosity during melting by rational precursor design."];
  "R2" [label="(0,0,0) Because some porous single-ligand ZIFs recrystallize into a dense ZIF-zni phase before melting while some ZIFs are known to form glasses by melt-quenching, porosity-preserving meltable ZIF design should address dense recrystallization during the melting process."];
  "R8" [label="(0,0,0) Given the urgent need for advanced materials for CO₂ capture and gas separations, crystalline MOFs with high porosity and precise pore sizes are promising candidates for these separation challenges."];
  "abd_know_glass" [label="(7,0,0) Abduction-knowledge: The discovery of MOF glasses, recognised as a fourth category of glass materials (dissimilar to inorganic/organic/metallic), opens up possible opportunities to process MOFs into macroscale, grain-boundary-free morphologies (sentence 7; enabled by melt-quenching of ZIFs, sentence 9, and forming methods like hot-pressing, sentence 11)."];
  "abd_know_mixed" [label="(9,0,0) Abduction-knowledge: A few types of ZIFs (class of MOFs with tetrahedral metal ions linked by imidazolate ions, sentence 8) have been discovered with the capability to form glasses via melt-quenching (sentence 9), and prototypical ZIF-62 with mixed ligands enables stable melting (sentence 17)."];
  "abd_phen_mech" [label="(6,0,0) Abduction-phenomenon: Practical implementation of crystalline MOFs is still hampered by inherent limitations in mechanical stability of microcrystalline powders, despite required processing (pelletization/coating/sintering, sentence 5)."];
  "abd_phen_recryst" [label="(24,0,0) Abduction-phenomenon: However, CAN-[Zn(Im)₂] and AFI-[Zn(Im)₂] will recrystallize to the dense ZIF-zni phase with 4 MR before melting, similar with ZIF-4, leading to porosity loss in agZIF-zni glass (sentence 24; also sentence 25)."];
  "case_climate_mof" [label="(0,0,0) Currently there is urgent need for advanced materials for CO₂ capture and gas separations to mitigate climate change."];
  "case_glass_por" [label="(0,0,0) Currently there is MOF glasses open opportunities for macroscale grain-boundary-free morphologies but porosity is reduced upon glass formation."];
  "case_por" [label="(15,0,0) Currently, achieving precise manipulation of porosity in MOF glass at the Ångstrom scale remains a significant challenge (sentence 15; pore-inducing agents like polymers only give coarse control, sentence 14)."];
  "climate_need" [label="(0,0,0) induction-reasoning: From the case of fossil-fuel-driven climate worsening and the common research focus on carbon capture, so there is urgent need for advanced materials enabling efficient CO₂ capture and energy-related gas separations."];
  "glass_opp" [label="(0,0,0) abduction-reasoning: Phenomenon: mechanical stability and processing limitations hamper crystalline MOF device applications, and knowledge: MOF glasses enable macroscale grain-boundary-free forms, so MOF glasses open opportunities for practical membrane modules while retaining MOF functionality."];
  "glass_por_link" [label="(13,0,0) deduction-reasoning: Currently there is the opportunity from MOF glasses, and if porosity is reduced, so substantial enhancement in porosity is imperative (linking to por_concl)."];
  "ind_case_climate" [label="(1,0,0) Induction-case: Excessive energy consumption, particularly from the continuous burning of fossil fuels, has significantly worsened climate change (sentence 1)."];
  "ind_case_mofstruct" [label="(3,0,0) Induction-case: MOFs are cage-like structures containing metal nodes and organic ligands connected in infinite arrays (sentence 3)."];
  "ind_common_mofpor" [label="(4,0,0) Induction-common: The highly porous structures and precise pore size distributions of crystalline MOFs give them potential applications in various energy and environment-related gas separations, such as natural gas purification and CO₂ capture (sentence 4)."];
  "ind_common_research" [label="(2,0,0) Induction-common: Extensive research has focused on clean energy production and carbon capture to reduce the release of greenhouse gases, mainly CO₂ emissions, into the atmosphere during the process of extracting, producing, and using energy (sentence 2)."];
  "mof_potential" [label="(0,0,0) induction-reasoning: From the case of MOF cage-like structures and the common of high porosity/precise pores, so crystalline MOFs have potential applications in energy/environment-related gas separations."];
  "por_concl" [label="(13,0,0) deduction-reasoning: Currently there is reduction in porosity upon glass formation which is unfavorable for gas separation, and if precise Ångstrom-scale manipulation is challenging, so a substantial enhancement in porosity is imperative for MOF glasses to emerge as practical solutions for gas separation challenges."];
  "rule_climate_mof" [label="(0,0,0) If there is urgent need for advanced materials for CO₂ capture and gas separations (from climate_need), then crystalline MOFs with high porosity and precise pore sizes are promising candidates (from mof_potential)."];
  "rule_glass_por" [label="(0,0,0) If MOF glasses solve mechanical/processing issues but suffer reduced porosity upon formation (from glass_opp and sentence 10), then substantial porosity enhancement is imperative to realise practical gas-separation applications."];
  "rule_por" [label="(12,0,0) If upon glass formation the inherent porosity in their crystalline precursors is reduced, then it would be unfavorable for possible applications in gas separation compared with other pure polycrystalline MOFs (sentence 12; also sentences 10, 21–25)."];
  "rule_por" -> "por_concl" [label="deduction-rule"];

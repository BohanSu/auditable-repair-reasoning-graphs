digraph ReasoningTree {
  // paper_id=s41467-025-56852-4
  rankdir="TB";
  "C_art" [label="(0,0,0) deduction-reasoning: Given positive constraint after FBP and if positive constraint then artifacts, therefore the projection patterns produce 3D dose with artifacts (covers s11,s13,s14,s15)."];
  "C_blur" [label="(0,0,0) deduction-reasoning: Given vial diameter >> depth of focus and if vial diameter >> depth of focus then blurring, therefore blurring artifacts compromise resolution in large-vial TVAM (covers s17,s18)."];
  "C_eff" [label="(0,0,0) induction-reasoning: Given phase-encoding improves efficiency by all pixels contributing and common pattern of holographic interference, therefore phase-encoding improves light efficiency over amplitude."];
  "NROOT" [label="(0,0,0) The paper proposes and evaluates HoloVAM, a tomographic volumetric additive-manufacturing scheme that replaces inefficient amplitude patterns with DMD-generated phase-encoded holographic projections to improve light efficiency, digitally tailor the 3-D point-spread function, and enable rapid fabrication of millimeter-scale polymer and cell-laden hydrogel objects with about 30 µm feature resolution using a single 40 mW laser diode.", fillcolor="lightyellow", style="filled"];
  "NROOT_COMMON" [label="(0,0,0) When amplitude-pattern TVAM is limited by inefficient light delivery and optical artifacts, phase-encoded holographic projection is a coherent strategy to investigate because it can redirect light more efficiently and digitally tailor the 3-D point-spread function."];
  "N_case_art" [label="(12,0,0) Currently there is: Due to the positive constraint applied to the intensity patterns after the Filtered Back Projection (FBP), the computed projection patterns produce a 3D dose with artifacts."];
  "N_case_blur" [label="(20,0,0) Currently there is: If the vial’s diameter is much larger than the depth of focus, blurring artifacts appear and compromise the resolution."];
  "N_case_eff" [label="(29,0,0) Currently there is: Phase-encoding improves light efficiency, as all pixels of the display can contribute to the projected intensity pattern."];
  "N_case_ineff" [label="(31,0,0) Currently there is: Amplitude encoding is therefore highly inefficient: typically, less than 1% of the incident light reaches the vial."];
  "N_case_prom" [label="(9,0,0) Currently there is: The technique has proven versatile and has been used to fabricate objects in materials such as acrylates, thiol-enes, nanoparticle-loaded composites, polymer-derived ceramics, epoxies, silk bioinks, and cell-laden hydrogels."];
  "N_case_psf" [label="(32,0,0) Currently there is: Phase-encoding allows a modification of the point spread function (PSF) to be encoded within the same hologram, allowing 3D digital control of the light beam (e.g., Axicon for Bessel beam, Fresnel for multi-plane low-divergence)."];
  "N_case_self" [label="(33,0,0) Currently there is: A self-healing beam, generated using a Helical Phase Plate (HPP) to produce an Optical Vortex (OV), enables printing within scattering materials."];
  "N_common_adv" [label="(0,0,0) Common pattern: Phase encoding in optical systems (including tiled holograms with PSF modification, Lee holograms for DMD, Gerchberg-Saxton algorithms) provides efficiency, control, and robustness advantages (covers s42,s43 + ref32,ref33,ref34,ref35,ref36)."];
  "N_common_eff" [label="(0,0,0) Common pattern: Phase holograms enable constructive interference so all modulator pixels contribute to the Fourier-plane intensity (covers s34,s35 + GS/Lee algorithms s36,s37 + prior TPL use s38 + ref29,ref30,ref31)."];
  "N_common_prom" [label="(0,0,0) Common pattern: Volumetric additive manufacturing methods simplify complex geometry fabrication (s1), enable cavities/overhangs without supports (s4), allow layer-less simultaneous solidification (s6,s7), achieve tens-of-seconds printing for cm-scale with 50-80 μm resolution using high-power diodes (s8), and support diverse materials including bioinks (s9)."];
  "N_common_psf" [label="(0,0,0) Common pattern: Phase modulation in holograms encodes additional optical functions to modify PSF, extend depth of focus, or create low-divergence projections (covers s21,s22)."];
  "N_common_self" [label="(0,0,0) Common pattern: Helical phase plates generate optical vortices that produce self-healing beams resistant to scattering."];
  "N_rule_art" [label="(0,0,0) If the intensity patterns after Filtered Back Projection have positive constraint, then the computed projection patterns produce a 3D dose with artifacts."];
  "N_rule_blur" [label="(0,0,0) If the vial’s diameter is much larger than the depth of focus of the imaging system for quasi-collimated projection (s19,s21), then blurring artifacts appear and compromise the resolution."];
  "N_rule_ineff" [label="(0,0,0) If the 2D SLM/DMD modulates only intensity not phase (s23,s24,s25) and tomographic projection patterns exhibit high spatial frequency information (most pixels dark, s30), then amplitude encoding is highly inefficient with <1% light reaching the vial."];
  "N_rule_merge_prob" [label="(0,0,0) If TVAM is fast/versatile/promising (from C_prom) but current amplitude-based implementations suffer from artifacts (C_art), blurring (C_blur), low efficiency (C_ineff), and overall limitations (C_current), then the observed phenomenon is that the light engine using amplitude modulation limits performance."];
  "R1" [label="(0,0,0) TVAM is a fast and versatile volumetric additive-manufacturing approach for fabricating complex objects across multiple material classes."];
  "R12" [label="(0,0,0) TVAM combines promising, fast, versatile volumetric fabrication with light-delivery limitations including dose artifacts, blurring in large vials, and low efficiency of amplitude-pattern projection."];
  "R13" [label="(0,0,0) Phase encoding of tomographic projections offers multiple light-delivery advantages over amplitude modulation, including improved light efficiency, PSF-based 3-D beam control, and scattering-robust self-healing beam options."];
  "R4" [label="(0,0,0) The reported less-than-1% delivery of incident light to the vial is consistent with amplitude/intensity-only projection patterns being a major source of low light efficiency in current TVAM."];
  "R7" [label="(0,0,0) Phase-encoded holograms can encode point-spread-function modifications, such as axicon or Fresnel functions, to digitally control the 3-D light beam and extend depth of focus."];
  "R8" [label="(0,0,0) Helical-phase or optical-vortex beam shaping can generate self-healing beams that support printing within scattering materials."];
  "N_case_art" -> "C_art" [label="deduction-case"];
  "N_rule_art" -> "C_art" [label="deduction-rule"];
  "N_case_blur" -> "C_blur" [label="deduction-case"];
  "N_rule_blur" -> "C_blur" [label="deduction-rule"];
  "N_case_eff" -> "C_eff" [label="induction-case"];
  "N_common_eff" -> "C_eff" [label="induction-common"];
  "N_case_prom" -> "R1" [label="induction-case"];
  "N_common_prom" -> "R1" [label="induction-common"];
  "N_case_ineff" -> "R4" [label="abduction-phenomenon"];
  "N_rule_ineff" -> "R4" [label="abduction-knowledge"];
  "N_case_psf" -> "R7" [label="induction-case"];
  "N_common_psf" -> "R7" [label="induction-common"];
  "N_case_self" -> "R8" [label="induction-case"];
  "N_common_self" -> "R8" [label="induction-common"];
  "R1" -> "R12" [label="induction-case"];
  "N_rule_merge_prob" -> "R12" [label="induction-common"];
  "C_eff" -> "R13" [label="induction-case"];
  "N_common_adv" -> "R13" [label="induction-common"];
  "C_art" -> "NROOT" [label="induction-case"];
  "C_blur" -> "NROOT" [label="induction-case"];
  "R12" -> "NROOT" [label="induction-case"];
  "R13" -> "NROOT" [label="induction-case"];
  "R4" -> "NROOT" [label="induction-case"];
  "R7" -> "NROOT" [label="induction-case"];
  "R8" -> "NROOT" [label="induction-case"];
  "NROOT_COMMON" -> "NROOT" [label="induction-common"];
}

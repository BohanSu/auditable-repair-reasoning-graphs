  "R5" [label="(0,0,0) Viral metagenomics is an appropriate tool to apply to rice ecosystems when searching for underrecognized or hidden rice-associated viruses without requiring prior viral knowledge."];
  "R6" [label="(0,0,0) Applying viral metagenomic analysis to publicly available rice RNA-seq data is a promising research avenue for virus identification because those data have not been systematically analyzed for this purpose."];
